<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ثبت‌نام کاربر</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
      background: #121212;
      color: #fff;
      font-family: Tahoma, Arial, sans-serif;
    }
    .card {
      width: min(460px, 100%);
      background: #202020;
      border: 1px solid #3a3a3a;
      border-radius: 16px;
      padding: 22px;
    }
    h1 { margin: 0 0 8px; font-size: 22px; }
    .hint { margin: 0 0 18px; color: #bdbdbd; font-size: 13px; }
    label { display: block; margin: 13px 0 6px; font-size: 14px; }
    input, textarea {
      width: 100%;
      border: 1px solid #555;
      border-radius: 9px;
      background: #2b2b2b;
      color: #fff;
      padding: 11px;
      font: inherit;
      outline: none;
    }
    input { height: 44px; }
    textarea { min-height: 78px; resize: vertical; }
    input:focus, textarea:focus { border-color: #ff4b2b; }
    button {
      width: 100%;
      height: 45px;
      margin-top: 20px;
      border: 0;
      border-radius: 9px;
      background: #ff4b2b;
      color: #fff;
      font: inherit;
      cursor: pointer;
    }
    button:disabled { opacity: .6; cursor: not-allowed; }
    #status {
      min-height: 22px;
      margin-top: 14px;
      line-height: 1.7;
      font-size: 13px;
      color: #ffb4a6;
    }
    #status.success { color: #70e0a0; }
  </style>

<style id="unified-account-v2">

/* ===== Unified Account UI V2 ===== */

body{
  background:
    radial-gradient(circle at 50% -10%,rgba(6,182,212,.13),transparent 38%),
    radial-gradient(circle at 100% 100%,rgba(37,99,235,.10),transparent 40%),
    #030712!important;
  color:#f0f6fc!important;
}

main,
.account-container,
.account-page,
.container{
  width:100%!important;
  max-width:620px!important;
  margin-left:auto!important;
  margin-right:auto!important;
}

.card,
.account-card,
.profile-card,
.panel{
  background:rgba(17,24,39,.78)!important;
  border:1px solid rgba(148,163,184,.12)!important;
  border-radius:22px!important;
  box-shadow:0 20px 55px rgba(0,0,0,.42)!important;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

button,
.btn{
  border-radius:13px!important;
  font-family:inherit!important;
  transition:transform .2s,box-shadow .2s,filter .2s;
}

button:hover:not(:disabled),
.btn:hover{
  transform:translateY(-2px);
}

input,
select{
  background:#0b1220!important;
  color:#f8fafc!important;
  border:1px solid rgba(34,211,238,.15)!important;
  border-radius:13px!important;
}

input:focus,
select:focus{
  border-color:rgba(34,211,238,.55)!important;
  box-shadow:0 0 0 3px rgba(6,182,212,.08)!important;
  outline:none!important;
}

.profile,
.user-profile{
  background:
    linear-gradient(
      145deg,
      rgba(6,182,212,.10),
      rgba(37,99,235,.08)
    )!important;
  border:1px solid rgba(34,211,238,.12)!important;
  border-radius:18px!important;
}

.avatar,
.profile-avatar{
  border:2px solid rgba(34,211,238,.35)!important;
  box-shadow:0 0 25px rgba(6,182,212,.12);
}

@media(max-width:600px){
  body{
    padding:10px!important;
  }

  main,
  .account-container,
  .account-page,
  .container{
    max-width:100%!important;
  }

  .card,
  .account-card,
  .profile-card,
  .panel{
    border-radius:18px!important;
  }
}

</style>


<style id="premium-chat-account-ui">
:root{
--p-bg:#070b12;--p-card:rgba(17,24,39,.82);--p-border:rgba(148,163,184,.14);
--p-text:#f8fafc;--p-muted:#94a3b8;--p-primary:#06b6d4;--p-secondary:#3b82f6;
}
body{
background:
radial-gradient(circle at 50% -10%,rgba(6,182,212,.14),transparent 38%),
radial-gradient(circle at 100% 100%,rgba(59,130,246,.10),transparent 35%),
var(--p-bg)!important;
color:var(--p-text)!important;
}
.card,main.card{
background:linear-gradient(145deg,var(--p-card),rgba(15,23,42,.72))!important;
border:1px solid var(--p-border)!important;
border-radius:24px!important;
box-shadow:0 20px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.035)!important;
backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);
}
h1,h2{color:var(--p-text);font-weight:900}
input,textarea,select{
background:rgba(2,6,23,.62)!important;
color:var(--p-text)!important;
border:1px solid rgba(148,163,184,.18)!important;
border-radius:14px!important;
}
input:focus,textarea:focus,select:focus{
outline:none!important;
border-color:rgba(6,182,212,.65)!important;
box-shadow:0 0 0 3px rgba(6,182,212,.10)!important;
}
button{
border-radius:14px!important;
font-weight:800!important;
transition:.18s ease!important;
}
button:hover:not(:disabled){
transform:translateY(-2px);
filter:brightness(1.08);
}
#signup-btn,#chat-send,#analyzeButton{
background:linear-gradient(135deg,var(--p-primary),var(--p-secondary))!important;
color:#fff!important;
border:0!important;
box-shadow:0 10px 30px rgba(6,182,212,.20)!important;
}
#chat-window{
background:linear-gradient(145deg,rgba(15,23,42,.96),rgba(7,11,18,.96))!important;
border:1px solid var(--p-border)!important;
border-radius:24px!important;
box-shadow:0 25px 70px rgba(0,0,0,.55)!important;
}
#chat-input{background:rgba(2,6,23,.75)!important}
#chat-send{
width:46px!important;height:46px!important;
min-width:46px!important;border-radius:14px!important;
}
#chat-fab{
background:linear-gradient(135deg,var(--p-primary),var(--p-secondary))!important;
border:1px solid rgba(255,255,255,.12)!important;
box-shadow:0 12px 35px rgba(6,182,212,.28)!important;
}
.sub,label{color:var(--p-muted)}
@media(max-width:600px){
body{padding-left:10px!important;padding-right:10px!important}
main{width:100%!important}
.card,main.card{border-radius:20px!important}
}
</style>

</head>
<body>
  <main class="card">
    <h1>ثبت‌نام</h1>
    <p class="hint">اطلاعات شما برای تکمیل حساب کاربری ذخیره می‌شود.</p>

    <form id="signup-form">
      <label for="full-name">نام و نام خانوادگی</label>
      <input id="full-name" type="text" required autocomplete="name" placeholder="مثلاً علی رضایی">

      <label for="phone">شماره تلفن</label>
      <input id="phone" type="tel" required autocomplete="tel" placeholder="مثلاً 09123456789">

      <label for="address">آدرس</label>
      <textarea id="address" required autocomplete="street-address" placeholder="استان، شهر، آدرس کامل"></textarea>

      <label for="email">ایمیل</label>
      <input id="email" type="email" required autocomplete="email" placeholder="example@email.com">

      <label for="password">رمز عبور</label>
      <input id="password" type="password" required minlength="6" autocomplete="new-password" placeholder="حداقل ۶ کاراکتر">

      <button id="signup-btn" type="submit">ساخت حساب</button>
      <div id="status"></div>
    </form>
  </main>

  <script>
    const SUPABASE_URL = 'https://zpobmwhvhqjcqmaoqtxq.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ruoLdqEOaFEuQjPt5e0Huw_KwKAOp4T';

    const form = document.getElementById('signup-form');
    const button = document.getElementById('signup-btn');
    const statusBox = document.getElementById('status');

    function setStatus(text, success) {
      statusBox.textContent = text;
      statusBox.className = success ? 'success' : '';
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();

      const fullName = document.getElementById('full-name').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const address = document.getElementById('address').value.trim();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      button.disabled = true;
      setStatus('در حال ساخت حساب…');

      try {
        const response = await fetch(SUPABASE_URL + '/auth/v1/signup', {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email: email,
            password: password,
            data: {
              full_name: fullName,
              phone: phone,
              address: address
            }
          })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.msg || result.message || 'ثبت‌نام ناموفق بود.');
        }

        form.reset();

        if (result.user && result.user.identities && result.user.identities.length === 0) {
          setStatus('این ایمیل قبلاً ثبت شده است. وارد حساب شوید.', false);
        } else {
          setStatus('ثبت‌نام با موفقیت انجام شد؛ در حال ورود به سایت…', true);
          setTimeout(() => { window.location.href = 'index.html'; }, 900);
        }
      } catch (error) {
        console.error(error);
        setStatus(error.message || 'خطا در ثبت‌نام. دوباره تلاش کنید.', false);
      } finally {
        button.disabled = false;
      }
    });
  </script>
  <script src="app-nav.js?v=2"></script>
</body>
</html>
