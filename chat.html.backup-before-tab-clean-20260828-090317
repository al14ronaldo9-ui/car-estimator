/* ===== Modern UI/UX Enhancements ===== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

.card,
.result-card {
  background: rgba(255, 255, 255, 0.88) !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 24px !important;
  border: 1px solid rgba(255, 255, 255, 0.45) !important;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08) !important;
  animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

#loadingOverlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.spinner {
  width: 60px;
  height: 60px;
  border: 6px solid rgba(59, 130, 246, 0.15);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20px;
  font-family: Tahoma, sans-serif;
  font-weight: bold;
  color: #1e40af;
}

#analyzeButton:not(:disabled) {
  animation: pulse 2s infinite;
  background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
}

        @import url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css');

        :root {
            --bg-gradient: linear-gradient(135deg, #090d16 0%, #05070c 100%);
            --panel-bg: rgba(17, 24, 39, 0.7);
            --border-glow: rgba(6, 182, 212, 0.15);
            --border-hover: rgba(6, 182, 212, 0.4);
            --primary: #06b6d4;
            --secondary: #3b82f6;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --success: #10b981;
            --danger: #f43f5e;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Vazirmatn, Tahoma, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #030712; background-image: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #030712 60%), radial-gradient(circle at 10% 90%, #065f46 0%, transparent 50%); background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            padding: 20px 16px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        main {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 8px;
        }

        header h1 {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(120deg, #38bdf8, #06b6d4, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        header .sub {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .card {
            background: var(--panel-bg);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

        .picker {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px dashed rgba(6, 182, 212, 0.25);
            border-radius: 16px;
            padding: 32px 20px;
            text-align: center;
            cursor: pointer;
            background: rgba(15, 23, 42, 0.3);
            transition: all 0.25s ease;
        }

        .picker:hover {
            border-color: var(--primary);
            background: rgba(15, 23, 42, 0.5);
            transform: translateY(-2px);
        }

        .picker-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
            filter: drop-shadow(0 0 10px rgba(6, 182, 212, 0.4));
        }

        .picker-text {
            font-weight: 700;
            font-size: 0.95rem;
            color: #e2e8f0;
            margin-bottom: 4px;
        }

        .picker-subtext {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .picker input {
            display: none;
        }

        .preview-wrapper {
            position: relative;
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            background: #020617;
            margin-top: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        #preview {
            width: 100%;
            height: auto;
            display: none;
            border-radius: 14px;
        }

        #overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            border-radius: 14px;
        }

        #analyzeButton {
            width: 100%;
            padding: 15px;
            margin-top: 16px;
            border: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #fff;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(6, 182, 212, 0.35);
            transition: all 0.25s ease;
        }

        #analyzeButton:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(6, 182, 212, 0.5);
        }

        #analyzeButton:disabled {
            background: #1e293b;
            color: #64748b;
            box-shadow: none;
            cursor: not-allowed;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        #status {
            margin-top: 14px;
            font-size: 0.85rem;
            text-align: center;
            font-weight: 500;
            color: var(--text-muted);
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.02);
            min-height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        #status.ok {
            color: var(--success);
            background: rgba(16, 185, 129, 0.08);
            border-color: rgba(16, 185, 129, 0.2);
        }

        #status.error {
            color: var(--danger);
            background: rgba(244, 63, 94, 0.08);
            border-color: rgba(244, 63, 94, 0.2);
        }

        .hidden {
            display: none !important;
        }

        #debugInfo {
            margin-top: 12px;
            padding: 10px;
            background: rgba(2, 6, 23, 0.85);
            border: 1px dashed rgba(6, 182, 212, 0.3);
            border-radius: 10px;
            color: #7dd3fc;
            font-family: 'Courier New', monospace;
            font-size: 0.68rem;
            line-height: 1.8;
            direction: ltr;
            text-align: left;
            max-height: 170px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }

        #resultCard h2 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #f1f5f9;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 18px;
            background: rgba(15, 23, 42, 0.3);
            padding: 10px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.02);
        }

        .legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: #cbd5e1;
            font-weight: 600;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(15, 23, 42, 0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            text-align: right;
        }

        th, td {
            padding: 12px 14px;
        }

        th {
            background: rgba(15, 23, 42, 0.6);
            color: #38bdf8;
            font-weight: 700;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        td {
            color: #e2e8f0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        tr:last-child td {
            border-bottom: none;
        }

        .total-row td {
            background: rgba(6, 182, 212, 0.08);
            color: #22d3ee;
            font-weight: 800;
            font-size: 0.95rem;
            border-top: 1px solid rgba(6, 182, 212, 0.3);
        }
