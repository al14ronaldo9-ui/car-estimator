            text += `- ${cells[0].textContent.trim()}: ${cells[1].textContent.trim()} مورد - هزینه: ${cells[3].textContent.trim()}\n`;
        }
    });
    
    const total = document.getElementById('totalCost');
    if (total) text += `\nهزینه کل: ${total.textContent.trim()}`;
    
    if (navigator.share) {
        try {
            await navigator.share({ title: 'گزارش برآورد خسارت', text: text });
            setStatus('گزارش به اشتراک گذاشته شد.', 'ok');
        } catch (e) {}
    } else {
