  const COST_RULES = [
    { base: 5000000,  perArea: 3000000 }, // فرورفتگی
    { base: 2000000,  perArea: 1500000 }, // خط و خش
    { base: 4000000,  perArea: 4000000 }, // ترک
    { base: 12000000, perArea: 6000000 }, // شیشه شکسته
    { base: 5000000,  perArea: 4000000 }, // چراغ شکسته
    { base: 3500000,  perArea: 2500000 }  // لاستیک پنچر
  ];


const INPUT_SIZE = 640;
const PROTO_SIZE = 160;
const NUM_CLASSES = 6;
const NUM_COEFFS = 32;
const CONF_THRESHOLD = 0.30;
const IOU_THRESHOLD = 0.40;
const MASK_THRESHOLD = 0.5;
const MASK_SCALE = PROTO_SIZE / INPUT_SIZE;
const CHANNEL_ORDER = 'RGB';

let session = null;
let currentImage = null;

const $ = id => document.getElementById(id);
const imageInput = $('imageInput');
const preview = $('preview');
const overlay = $('overlay');
const analyzeButton = $('analyzeButton');
const statusEl = $('status');
const resultCard = $('resultCard');
const resultBody = $('resultBody');
const totalCostEl = $('totalCost');
const legendEl = $('legend');
const debugEl = $('debugInfo');

/* EARLIEST_UPDATE_ANALYZE_BUTTON_FALLBACK */
window.updateAnalyzeButton = function () {
  // تا تعریف کامل تابع در اسکریپت‌های بعدی، فقط از توقف برنامه جلوگیری می‌کند.
};


function dbg(msg) {
  console.log('[debug]', msg);
}

function clearDbg() {
  if (debugEl) {
    debugEl.innerHTML = '';
    debugEl.classList.add('hidden');
  }
}

function setStatus(msg, type = '') {
  statusEl.textContent = msg;
  statusEl.className = type;
}

function sigmoid(x) {
  return 1 / (1 + Math.exp(-x));
}

function letterbox(img, targetSize = 640) {
  const canvas = document.createElement('canvas');
  canvas.width = targetSize;
  canvas.height = targetSize;
  const ctx = canvas.getContext('2d');

  ctx.fillStyle = '#727272';
  ctx.fillRect(0, 0, targetSize, targetSize);

  const scale = Math.min(targetSize / img.naturalWidth, targetSize / img.naturalHeight);
  const w = img.naturalWidth * scale;
  const h = img.naturalHeight * scale;
  const dx = (targetSize - w) / 2;
  const dy = (targetSize - h) / 2;

  ctx.drawImage(img, 0, 0, img.naturalWidth, img.naturalHeight, dx, dy, w, h);
  return { canvas, scale, dx, dy, w, h };
}

function canvasToTensor(canvas) {
  const ctx = canvas.getContext('2d');
  const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const d = imgData.data;
  const n = canvas.width * canvas.height;
  const arr = new Float32Array(3 * n);

  const rIdx = CHANNEL_ORDER === 'BGR' ? 2 : 0;
  const bIdx = CHANNEL_ORDER === 'BGR' ? 0 : 2;

  for (let i = 0; i < n; i++) {
    arr[i] = d[i * 4 + rIdx] / 255.0;
    arr[n + i] = d[i * 4 + 1] / 255.0;
    arr[2 * n + i] = d[i * 4 + bIdx] / 255.0;
  }
  return new ort.Tensor('float32', arr, [1, 3, canvas.width, canvas.height]);
}

function calculateIoU(box1, box2) {
  const x1 = Math.max(box1.x1, box2.x1);
  const y1 = Math.max(box1.y1, box2.y1);
  const x2 = Math.min(box1.x2, box2.x2);
  const y2 = Math.min(box1.y2, box2.y2);

  const inter = Math.max(0, x2 - x1) * Math.max(0, y2 - y1);
  const area1 = (box1.x2 - box1.x1) * (box1.y2 - box1.y1);
  const area2 = (box2.x2 - box2.x1) * (box2.y2 - box2.y1);
  const union = area1 + area2 - inter;

  return union <= 0 ? 0 : inter / union;
}

function nms(dets) {
  const sorted = dets.slice().sort((a, b) => b.score - a.score);
  const keep = [];
  const active = new Array(sorted.length).fill(true);

  for (let i = 0; i < sorted.length; i++) {
    if (!active[i]) continue;
    keep.push(sorted[i]);
    for (let j = i + 1; j < sorted.length; j++) {
      if (active[j] && sorted[j].classId === sorted[i].classId &&
          calculateIoU(sorted[i], sorted[j]) > IOU_THRESHOLD) {
        active[j] = false;
      }
    }
  }
  return keep;
}
function buildMask(coeffs, protoOut) {
  const pd = protoOut.dims;
  const protos = protoOut.data;

  let channelFirst = true;
  if (pd.length === 4 && pd[1] === PROTO_SIZE && pd[2] === PROTO_SIZE && pd[3] === NUM_COEFFS) {
    channelFirst = false;
  } else if (pd.length === 4 && pd[1] === NUM_COEFFS) {
    channelFirst = true;
  } else {
    throw new Error('shape پروتوتایپ ماسک غیرمنتظره: [' + pd.join(',') + ']');
  }

  const mask = new Uint8Array(PROTO_SIZE * PROTO_SIZE);
  for (let p = 0; p < PROTO_SIZE * PROTO_SIZE; p++) {
    let s = 0;
    for (let c = 0; c < NUM_COEFFS; c++) {
      const idx = channelFirst ? c * PROTO_SIZE * PROTO_SIZE + p : p * NUM_COEFFS + c;
      s += coeffs[c] * protos[idx];
    }
    mask[p] = s > 0 ? 1 : 0;
  }
  return mask;
}

function analyzeOutput(detOut, protoOut, meta) {
  const data = detOut.data;
  const dims = detOut.dims;
  const rowLenFull = 4 + NUM_CLASSES + NUM_COEFFS;
  const rowLenObj = 4 + 1 + NUM_CLASSES + NUM_COEFFS;

  let rowLen, dim, transposed;
  if (dims.length === 3 && dims[1] === rowLenFull) {
    rowLen = dims[1]; dim = dims[2]; transposed = false;
  } else if (dims.length === 3 && dims[2] === rowLenFull) {
    rowLen = dims[2]; dim = dims[1]; transposed = true;
  } else if (dims.length === 3 && dims[1] === rowLenObj) {
    rowLen = dims[1]; dim = dims[2]; transposed = false;
  } else if (dims.length === 3 && dims[2] === rowLenObj) {
    rowLen = dims[2]; dim = dims[1]; transposed = true;
  } else {
    throw new Error('shape خروجی تشخیص غیرمنتظره: [' + dims.join(',') + ']');
  }

  const hasObj = rowLen === rowLenObj;
  const clsStart = hasObj ? 5 : 4;
  const coeffStart = clsStart + NUM_CLASSES;

  const get = (f, i) => transposed ? data[i * rowLen + f] : data[f * dim + i];

  let mn = Infinity, mx = -Infinity;
  for (let i = 0; i < dim; i++) {
    for (let c = 0; c < NUM_CLASSES; c++) {
      const v = get(clsStart + c, i);
      if (v < mn) mn = v;
      if (v > mx) mx = v;
    }
  }
  const useSigmoid = mn < -0.05 || mx > 1.05;
  dbg('layout: ' + (transposed ? '[1,N,' + rowLen + ']' : '[1,' + rowLen + ',N]') + ' | N=' + dim +
      (hasObj ? ' | همراه objectness' : '') + ' | scores: ' + (useSigmoid ? 'sigmoid (logit)' : 'خام (احتمال)'));

  const dets = [];
  for (let i = 0; i < dim; i++) {
    let bestCls = -1;
    let bestScore = -Infinity;

    for (let c = 0; c < NUM_CLASSES; c++) {
      const v = get(clsStart + c, i);
      if (v > bestScore) {
        bestScore = v;
        bestCls = c;
      }
    }

    let score = useSigmoid ? sigmoid(bestScore) : bestScore;
    if (hasObj) score *= sigmoid(get(4, i));
    if (bestCls < 0 || score < CONF_THRESHOLD) continue;

    const cx = get(0, i);
    const cy = get(1, i);
    const w = get(2, i);
    const h = get(3, i);

    const coeffs = [];
    for (let c = 0; c < NUM_COEFFS; c++) {
      coeffs.push(get(coeffStart + c, i));
    }

    dets.push({
      x1: cx - w / 2,
      y1: cy - h / 2,
      x2: cx + w / 2,
      y2: cy + h / 2,
      score,
      classId: bestCls,
      coeffs
    });
  }
  dbg('تشخیص خام: ' + dets.length);

  const topDets = dets
    .slice()
    .sort((a, b) => b.score - a.score)
    .slice(0, 40);

  const kept = nms(topDets);
  dbg('پس از NMS: ' + kept.length);

  const results = [];
  for (const d of kept) {
    const mask160 = buildMask(d.coeffs, protoOut);

    const bx0 = Math.max(0, Math.floor(d.x1 * MASK_SCALE));
    const by0 = Math.max(0, Math.floor(d.y1 * MASK_SCALE));
    const bx1 = Math.min(PROTO_SIZE, Math.ceil(d.x2 * MASK_SCALE));
    const by1 = Math.min(PROTO_SIZE, Math.ceil(d.y2 * MASK_SCALE));

    let maskPixels = 0;
    for (let y = by0; y < by1; y++) {
      for (let x = bx0; x < bx1; x++) {
        if (mask160[y * PROTO_SIZE + x] > MASK_THRESHOLD) maskPixels++;
      }
    }

    const areaFraction = Math.min(1, (maskPixels * 16) / (meta.w * meta.h));
    const box = {
      x1: Math.max(0, (d.x1 - meta.dx) / meta.scale),
      y1: Math.max(0, (d.y1 - meta.dy) / meta.scale),
      x2: Math.min(meta.origW, (d.x2 - meta.dx) / meta.scale),
      y2: Math.min(meta.origH, (d.y2 - meta.dy) / meta.scale)
    };

    results.push({
      classId: d.classId,
      score: d.score,
      box,
      box640: { x1: d.x1, y1: d.y1, x2: d.x2, y2: d.y2 },
      mask160,
      areaFraction
    });
  }
  return results;
}

function drawResults(results, img, meta) {
  overlay.width = img.naturalWidth;
  overlay.height = img.naturalHeight;

  const ctx = overlay.getContext('2d');
  ctx.drawImage(img, 0, 0);

  ctx.lineWidth = Math.max(2, Math.round(img.naturalWidth / 250));
  ctx.textAlign = 'left';
  ctx.direction = 'ltr';

  const mc = document.createElement('canvas');
  mc.width = 160;
  mc.height = 160;
  const mctx = mc.getContext('2d');

  for (const r of results) {
    const [cr, cg, cb] = CLASS_COLORS[r.classId] || [255, 255, 255];
    const imgData = mctx.createImageData(160, 160);
    const data = imgData.data;

    // ماسک فقط در محدودهٔ Bounding Box همان تشخیص نمایش داده می‌شود.
    const mx0 = Math.max(0, Math.floor(r.box640.x1 * MASK_SCALE));
    const my0 = Math.max(0, Math.floor(r.box640.y1 * MASK_SCALE));
    const mx1 = Math.min(PROTO_SIZE, Math.ceil(r.box640.x2 * MASK_SCALE));
    const my1 = Math.min(PROTO_SIZE, Math.ceil(r.box640.y2 * MASK_SCALE));

    for (let y = my0; y < my1; y++) {
      for (let x = mx0; x < mx1; x++) {
        const i = y * PROTO_SIZE + x;
        if (r.mask160[i]) {
          const idx = i * 4;
          data[idx] = cr;
          data[idx + 1] = cg;
          data[idx + 2] = cb;
          data[idx + 3] = 100;
        }
      }
    }
    mctx.putImageData(imgData, 0, 0);

    const sx = meta.dx * MASK_SCALE;
    const sy = meta.dy * MASK_SCALE;
    const sw = meta.w * MASK_SCALE;
    const sh = meta.h * MASK_SCALE;

    ctx.drawImage(mc, sx, sy, sw, sh, 0, 0, img.naturalWidth, img.naturalHeight);

    const bx = r.box.x1;
    const by = r.box.y1;
    const bw = r.box.x2 - r.box.x1;
    const bh = r.box.y2 - r.box.y1;

    ctx.fillStyle = `rgba(${cr},${cg},${cb},0.15)`;
    ctx.fillRect(bx, by, bw, bh);

    ctx.strokeStyle = `rgb(${cr},${cg},${cb})`;
    ctx.strokeRect(bx, by, bw, bh);

    const label = `${CLASS_NAMES[r.classId]} ${Math.round(r.score * 100)}%`;
    const baseFont = Math.max(12, Math.round(img.naturalWidth / 45));
    ctx.font = `600 ${baseFont}px Vazirmatn, Tahoma, sans-serif`;
    const tw = ctx.measureText(label).width;
    const ly = by > (baseFont + 10) ? by - 8 : by + baseFont + 10;

    ctx.fillStyle = `rgb(${cr},${cg},${cb})`;
    ctx.fillRect(bx, ly - baseFont - 4, tw + 10, baseFont + 8);

    ctx.fillStyle = '#ffffff';
    ctx.fillText(label, bx + 5, ly - 4);
  }

  preview.style.display = 'block';
  overlay.style.display = 'block';
}

function showResults(results) {
  const counts = {};
  const costs = {};
  let total = 0;

  for (const r of results) {
    counts[r.classId] = (counts[r.classId] || 0) + 1;
    const rule = COST_RULES[r.classId];
    const cost = Math.round((rule.base + rule.perArea * r.areaFraction) / 10000) * 10000;
    costs[r.classId] = (costs[r.classId] || 0) + cost;
    total += cost;
  }

  const summary = Object.keys(counts)
