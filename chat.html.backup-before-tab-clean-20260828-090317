<script id="forum-three-tabs-controller">
(function(){

  function init(){

    const forum = document.getElementById("forum-ui-v1");
    const chat = document.getElementById("chat-window");
    const publicPage = document.getElementById("public-chat-page");

    if(!forum || !chat || !publicPage){
      console.warn("3TABS: required elements missing");
      return;
    }

    const tabs = forum.querySelectorAll(".forum-tab");

    if(tabs.length < 3){
      console.warn("3TABS: three tabs not found");
      return;
    }

    const forumTab = tabs[0];
    const aiTab = tabs[1];
    const publicTab = tabs[2];

    function active(tab){
      tabs.forEach(function(t){
        t.classList.remove("active");
      });
      tab.classList.add("active");
    }

    function forumMode(){

      document.body.classList.remove("forum-ai-open");
      document.body.classList.remove("public-chat-open");

      chat.classList.remove("active");

      chat.style.removeProperty("display");
      chat.style.removeProperty("visibility");
      chat.style.removeProperty("opacity");

      active(forumTab);

      window.scrollTo(0,0);
    }

    function aiMode(){

      document.body.classList.remove("public-chat-open");
      document.body.classList.add("forum-ai-open");

      chat.classList.add("active");

      chat.style.setProperty("display","flex","important");
      chat.style.setProperty("visibility","visible","important");
      chat.style.setProperty("opacity","1","important");

      active(aiTab);

      window.scrollTo(0,0);
    }

    function publicMode(){

      document.body.classList.remove("forum-ai-open");
      document.body.classList.add("public-chat-open");

      chat.classList.remove("active");

      chat.style.removeProperty("display");
      chat.style.removeProperty("visibility");
      chat.style.removeProperty("opacity");

      active(publicTab);

      const box = document.getElementById("public-chat-messages");

      if(box){
        requestAnimationFrame(function(){
          box.scrollTop = box.scrollHeight;
        });
      }

      window.scrollTo(0,0);
    }

    forumTab.onclick = function(e){
      e.preventDefault();
      e.stopPropagation();
      forumMode();
    };

    aiTab.onclick = function(e){
      e.preventDefault();
      e.stopPropagation();
      aiMode();
    };

    publicTab.onclick = function(e){
      e.preventDefault();
      e.stopPropagation();
      publicMode();
    };

    /* دکمه برگشت داخل دستیار */
    const back = document.getElementById("forum-back-button");

    if(back){
      back.onclick = function(e){
        e.preventDefault();
        e.stopPropagation();
        forumMode();
      };
    }

    console.log("3TABS: CONTROLLER READY");

  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded",init);
  }else{
    init();
  }

})();
</script>


<script id="UNIFIED-FORUM-TABS">
(function(){

  function init(){

    const forum = document.getElementById("forum-ui-v1");
    const chat = document.getElementById("chat-window");
    const publicPage = document.getElementById("public-chat-page");

    if(!forum){
      console.warn("FORUM: not found");
      return;
    }

    const tabs = forum.querySelectorAll(".forum-tab");

    if(tabs.length < 3){
      console.warn("FORUM: tabs not found", tabs.length);
      return;
    }

    const forumTab = tabs[0];
    const aiTab = tabs[1];
    const publicTab = tabs[2];

    function activate(tab){
      tabs.forEach(function(t){
        t.classList.remove("active");
      });
      tab.classList.add("active");
    }

    function closeEverything(){

      document.body.classList.remove(
        "forum-ai-open",
        "public-chat-open"
      );

      if(chat){
        chat.classList.remove("active");
        chat.style.removeProperty("display");
        chat.style.removeProperty("visibility");
        chat.style.removeProperty("opacity");
      }

      if(publicPage){
        publicPage.style.removeProperty("display");
      }
    }

    /* انجمن */
    forumTab.onclick = function(e){

      e.preventDefault();
      e.stopPropagation();

      closeEverything();
      activate(forumTab);

      window.scrollTo(0,0);
    };

    /* دستیار هوشمند */
    aiTab.onclick = function(e){

      e.preventDefault();
      e.stopPropagation();

      document.body.classList.remove("public-chat-open");
      document.body.classList.add("forum-ai-open");

      if(chat){

        chat.classList.add("active");

        chat.style.setProperty(
          "display",
          "flex",
          "important"
        );

        chat.style.setProperty(
          "visibility",
          "visible",
          "important"
        );

        chat.style.setProperty(
          "opacity",
          "1",
          "important"
        );
      }

      if(publicPage){
        publicPage.style.setProperty(
          "display",
          "none",
          "important"
        );
      }

      activate(aiTab);

      /* جلوگیری از باز شدن خودکار کیبورد */
      const input = document.getElementById("chat-input");

      if(input){
        input.blur();
      }

      window.scrollTo(0,0);
    };

    /* گفتگوی عمومی */
    publicTab.onclick = function(e){

      e.preventDefault();
      e.stopPropagation();

      document.body.classList.remove("forum-ai-open");
      document.body.classList.add("public-chat-open");

      if(chat){

        chat.classList.remove("active");

        chat.style.removeProperty("display");
        chat.style.removeProperty("visibility");
        chat.style.removeProperty("opacity");
      }

      if(publicPage){

        publicPage.style.setProperty(
          "display",
          "flex",
          "important"
        );

        publicPage.style.setProperty(
          "visibility",
          "visible",
          "important"
        );

        publicPage.style.setProperty(
          "opacity",
          "1",
          "important"
        );
      }

      activate(publicTab);

      const box =
        document.getElementById("public-chat-messages");

      if(box){

        requestAnimationFrame(function(){
          box.scrollTop = box.scrollHeight;
        });
      }

      window.scrollTo(0,0);
    };

    console.log("UNIFIED FORUM TABS: READY");
  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded",init);
