<style id="public-chat-ui-v1">

#public-chat-page{
  display:none;
  position:fixed;
  inset:0;
  z-index:9000;
  flex-direction:column;
  direction:rtl;
  background:
    radial-gradient(circle at 50% -10%,rgba(6,182,212,.12),transparent 38%),
    #070b12;
  color:#f8fafc;
}

body.public-chat-open #forum-ui-v1,
body.public-chat-open #chatPage,
body.public-chat-open #chat-window,
body.public-chat-open #chat-fab{
  display:none!important;
}

body.public-chat-open #public-chat-page{
  display:flex!important;
}

.public-chat-header{
  flex:none;
  min-height:70px;
  padding:12px 15px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  background:rgba(10,16,27,.94);
  border-bottom:1px solid rgba(148,163,184,.12);
  backdrop-filter:blur(18px);
}

.public-chat-title{
  font-size:16px;
  font-weight:900;
}

.public-chat-sub{
  margin-top:4px;
  color:#7f8da3;
  font-size:10px;
}

.public-online{
  display:flex;
  align-items:center;
  gap:5px;
  padding:6px 9px;
  border-radius:9px;
  background:rgba(34,197,94,.07);
  border:1px solid rgba(34,197,94,.12);
  color:#86efac;
  font-size:9px;
  font-weight:800;
}

.public-online span{
  width:6px;
  height:6px;
  border-radius:50%;
  background:#22c55e;
  box-shadow:0 0 8px rgba(34,197,94,.7);
}

#public-chat-messages{
  flex:1;
  min-height:0;
  overflow-y:auto;
  padding:14px 12px 90px;
  display:flex;
  flex-direction:column;
  gap:9px;
  overscroll-behavior:contain;
}

.public-welcome{
  margin:8px auto 14px;
  max-width:310px;
  padding:15px;
  text-align:center;
  border:1px solid rgba(148,163,184,.10);
  border-radius:17px;
  background:rgba(15,23,42,.62);
}

.public-welcome-icon{
  font-size:25px;
  margin-bottom:6px;
}

.public-welcome strong{
  font-size:12px;
}

.public-welcome p{
  margin:6px 0 0;
  color:#8490a3;
  font-size:9px;
  line-height:1.8;
}

.public-message{
  max-width:82%;
  align-self:flex-start;
  padding:9px 11px;
  border-radius:14px 14px 14px 4px;
  background:linear-gradient(145deg,rgba(19,31,48,.95),rgba(12,20,32,.95));
  border:1px solid rgba(148,163,184,.10);
}

.public-message.mine{
  align-self:flex-end;
  border-radius:14px 14px 4px 14px;
  background:linear-gradient(145deg,rgba(8,91,112,.95),rgba(24,55,105,.95));
}

.public-message-name{
  margin-bottom:3px;
  color:#67e8f9;
  font-size:9px;
  font-weight:900;
}

.public-message-text{
  font-size:12px;
  line-height:1.75;
  word-break:break-word;
}

.public-message-time{
  margin-top:3px;
  color:#64748b;
  font-size:7px;
}

.public-chat-input-area{
  flex:none;
  display:flex;
  align-items:center;
  gap:8px;
  padding:9px 10px calc(9px + env(safe-area-inset-bottom));
  background:rgba(10,16,27,.97);
  border-top:1px solid rgba(148,163,184,.12);
}

#public-chat-input{
  flex:1;
  min-width:0;
  height:48px;
  padding:0 13px;
  border-radius:13px;
  border:1px solid rgba(148,163,184,.16);
  background:rgba(2,6,23,.72);
  color:#f8fafc;
  outline:none;
  font-family:inherit;
  font-size:12px;
  direction:rtl;
}

#public-chat-input:focus{
  border-color:rgba(6,182,212,.45);
  box-shadow:0 0 0 3px rgba(6,182,212,.07);
}

#public-chat-send{
  width:36px;
  min-width:36px;
  height:36px;
  padding:0;
  border:0;
  border-radius:13px;
  background:linear-gradient(135deg,#06b6d4,#2563eb);
  color:white;
  font-size:18px;
  font-weight:900;
}

#public-chat-send:active{
  transform:scale(.93);
}

@media(max-width:390px){
  .public-chat-header{
    padding-left:10px;
    padding-right:10px;
  }

  .public-chat-title{
    font-size:14px;
  }

  #public-chat-messages{
    padding-left:9px;
    padding-right:9px;
  }
}

</style>
\n













<style id="shared-tabs-click-fix">
.shared-tabs{
  position:relative!important;
  z-index:99999!important;
  pointer-events:auto!important;
}

.shared-tabs [data-shared-page]{
  position:relative!important;
  z-index:100000!important;
  pointer-events:auto!important;
  cursor:pointer!important;
}
</style>


<style id="public-chat-size-final">
#public-chat-page .public-chat-input-area{
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
  height:auto!important;
}

#public-chat-page #public-chat-input{
  flex:1!important;
  width:auto!important;
  min-width:0!important;
  height:44px!important;
  box-sizing:border-box!important;
}

#public-chat-page #public-chat-send{
  flex:0 0 36px!important;
  width:36px!important;
  min-width:36px!important;
  max-width:36px!important;
  height:36px!important;
  min-height:36px!important;
  max-height:36px!important;
  padding:0!important;
  box-sizing:border-box!important;
  border-radius:10px!important;
  font-size:16px!important;
}
</style>


<style id="FORUM-REDESIGN-V1">
/* ================================
   FORUM REDESIGN V1
   ظاهر فقط — منطق ناوبری دست‌نخورده
================================ */

#forum-ui-v1{
  background:
    radial-gradient(circle at 80% 0%,rgba(6,182,212,.10),transparent 30%),
    linear-gradient(180deg,#050a12 0%,#07111d 100%) !important;
}

/* NAV */
#forum-ui-v1 > .forum-header{
  padding:0 !important;
  background:transparent !important;
  border:0 !important;
}

#forum-ui-v1 .forum-header > .shared-tabs{
  margin:10px 12px 0 !important;
  padding:4px !important;
  height:46px !important;
  border-radius:15px !important;
  background:rgba(8,15,28,.88) !important;
  border:1px solid rgba(148,163,184,.10) !important;
  backdrop-filter:blur(16px);
}

#forum-ui-v1 .shared-tabs .forum-tab{
  height:38px !important;
  border-radius:11px !important;
  color:#7d8ba3 !important;
  font-size:.68rem !important;
  font-weight:800 !important;
}

#forum-ui-v1 .shared-tabs .forum-tab.active{
  color:#fff !important;
  background:linear-gradient(135deg,#075985,#1d4ed8) !important;
  box-shadow:0 5px 18px rgba(37,99,235,.22) !important;
}

/* حذف ظاهر ایموجی‌های ناوبری */
#forum-ui-v1 .shared-tabs .forum-tab{
  font-size:0 !important;
}
#forum-ui-v1 .shared-tabs .forum-tab:nth-child(1)::after{
  content:"انجمن";
  font-size:.68rem;
}
#forum-ui-v1 .shared-tabs .forum-tab:nth-child(2)::after{
  content:"دستیار";
  font-size:.68rem;
}
#forum-ui-v1 .shared-tabs .forum-tab:nth-child(3)::after{
  content:"گفتگوی عمومی";
  font-size:.68rem;
}

/* HERO */
#forum-ui-v1 .forum-title-row{
  position:relative !important;
  min-height:175px !important;
  margin:12px 12px 0 !important;
  padding:20px !important;
  overflow:hidden !important;
  border-radius:24px !important;

  background:
    linear-gradient(90deg,
      rgba(3,8,18,.97) 0%,
      rgba(3,8,18,.82) 42%,
      rgba(3,8,18,.18) 100%
    ),
    url("https://images.pexels.com/photos/37809577/pexels-photo-37809577/free-photo-of-auto-repair-technician-working-indoors.jpeg?auto=compress&cs=tinysrgb&w=1200")
    center/cover no-repeat !important;

  border:1px solid rgba(148,163,184,.12) !important;
  box-shadow:0 18px 50px rgba(0,0,0,.30) !important;
}

#forum-ui-v1 .forum-title-row::after{
  content:"AUTOMOTIVE COMMUNITY";
  position:absolute;
  left:20px;
  bottom:15px;
  color:rgba(255,255,255,.42);
  font-size:8px;
  letter-spacing:2px;
  font-weight:800;
}

#forum-ui-v1 .forum-title{
  position:relative;
  z-index:2;
  max-width:72%;
}

#forum-ui-v1 .forum-title-icon{
  width:46px !important;
  height:46px !important;
  margin-bottom:13px;
  border-radius:14px !important;

  background:
    url("https://images.pexels.com/photos/36281956/pexels-photo-36281956/free-photo-of-mechanic-working-on-luxury-car-in-modern-garage.jpeg?auto=compress&cs=tinysrgb&w=500")
    center/cover no-repeat !important;

  border:1px solid rgba(255,255,255,.18) !important;
  box-shadow:0 8px 25px rgba(0,0,0,.35) !important;

  font-size:0 !important;
}

#forum-ui-v1 .forum-title h1{
  font-size:1.45rem !important;
  line-height:1.2 !important;
  letter-spacing:-.5px;
  color:#fff !important;
}

#forum-ui-v1 .forum-title p{
  margin-top:7px !important;
  color:#cbd5e1 !important;
  font-size:.70rem !important;
  line-height:1.7;
}

/* CREATE */
#forum-ui-v1 .forum-create{
  position:absolute !important;
  z-index:3;
  left:16px !important;
  top:16px !important;
  width:40px !important;
  height:40px !important;
  border-radius:13px !important;
  font-size:0 !important;
  background:rgba(15,23,42,.75) !important;
  border:1px solid rgba(255,255,255,.15) !important;
  backdrop-filter:blur(12px);
  box-shadow:none !important;
}

#forum-ui-v1 .forum-create::before{
  content:"+";
  font-size:22px;
  color:#fff;
}

/* CONTENT */
#forum-ui-v1 .forum-content{
  padding:14px 12px 100px !important;
}

/* SEARCH */
#forum-ui-v1 .forum-search{
  height:48px !important;
  border-radius:15px !important;
  background:rgba(15,23,42,.82) !important;
  border:1px solid rgba(148,163,184,.12) !important;
  box-shadow:0 8px 25px rgba(0,0,0,.12);
}

#forum-ui-v1 .forum-search span{
  font-size:0 !important;
}

#forum-ui-v1 .forum-search span::before{
  content:"";
  display:block;
  width:15px;
  height:15px;
  border:2px solid #64748b;
  border-radius:50%;
  position:relative;
}

#forum-ui-v1 .forum-search input{
  font-size:.75rem !important;
}

/* CATEGORIES */
#forum-ui-v1 .forum-categories{
  gap:8px !important;
  margin:13px 0 17px !important;
}

#forum-ui-v1 .forum-category{
  padding:9px 14px !important;
  border-radius:12px !important;
  background:#0c1625 !important;
  border:1px solid rgba(148,163,184,.10) !important;
  color:#8fa0b8 !important;
  font-size:.63rem !important;
}

#forum-ui-v1 .forum-category.active{
  color:#fff !important;
  background:linear-gradient(135deg,#075985,#1d4ed8) !important;
  border-color:transparent !important;
}

/* SECTION */
#forum-ui-v1 .forum-section-title{
  margin:17px 2px 10px !important;
}

#forum-ui-v1 .forum-section-title strong{
  font-size:.90rem !important;
  color:#f8fafc;
}

#forum-ui-v1 .forum-section-title span{
  color:#64748b !important;
}

/* POSTS */
#forum-ui-v1 .forum-post{
  position:relative;
  overflow:hidden;
  margin-bottom:12px !important;
  padding:0 !important;
  border-radius:20px !important;
  background:#0a1422 !important;
  border:1px solid rgba(148,163,184,.10) !important;
  box-shadow:0 12px 32px rgba(0,0,0,.20) !important;
}

/* تصویر واقعی برای کارت‌ها */
#forum-ui-v1 .forum-post::before{
  content:"";
  display:block;
  width:100%;
  height:92px;
  background-position:center;
  background-size:cover;
  background-repeat:no-repeat;
  border-bottom:1px solid rgba(255,255,255,.08);
}

#forum-ui-v1 .forum-post:nth-of-type(1)::before{
  background-image:
    linear-gradient(90deg,rgba(4,10,18,.20),rgba(4,10,18,.05)),
    url("https://images.pexels.com/photos/6870313/pexels-photo-6870313.jpeg?auto=compress&cs=tinysrgb&w=900");
}

#forum-ui-v1 .forum-post:nth-of-type(2)::before{
  background-image:
    linear-gradient(90deg,rgba(4,10,18,.20),rgba(4,10,18,.05)),
    url("https://images.pexels.com/photos/36281956/pexels-photo-36281956/free-photo-of-mechanic-working-on-luxury-car-in-modern-garage.jpeg?auto=compress&cs=tinysrgb&w=900");
}

#forum-ui-v1 .forum-post:nth-of-type(3)::before{
  background-image:
    linear-gradient(90deg,rgba(4,10,18,.20),rgba(4,10,18,.05)),
    url("https://images.pexels.com/photos/37809544/pexels-photo-37809544/free-photo-of-man-working-on-car-in-auto-repair-shop.jpeg?auto=compress&cs=tinysrgb&w=900");
}

#forum-ui-v1 .forum-post > *{
  margin-left:14px !important;
  margin-right:14px !important;
}

#forum-ui-v1 .forum-user{
  padding-top:13px;
}

#forum-ui-v1 .forum-avatar{
  width:34px !important;
  height:34px !important;
  font-size:0 !important;
  background:
    linear-gradient(135deg,#0e7490,#1d4ed8) !important;
}

#forum-ui-v1 .forum-post h3{
  font-size:.82rem !important;
  line-height:1.75 !important;
}

#forum-ui-v1 .forum-post p{
  font-size:.67rem !important;
  color:#8fa0b8 !important;
  line-height:1.9 !important;
}

/* TAGS */
#forum-ui-v1 .forum-tag{
  border-radius:8px !important;
  background:#111d2e !important;
  color:#8191aa !important;
  padding:5px 8px !important;
}

/* ACTIONS */
#forum-ui-v1 .forum-actions{
  margin-top:12px !important;
  padding:10px 0 !important;
  border-top:1px solid rgba(148,163,184,.08) !important;
}

#forum-ui-v1 .forum-action{
  color:#718096 !important;
  font-size:.59rem !important;
}

#forum-ui-v1 .forum-action:hover{
  color:#22d3ee !important;
}

/* MECHANIC */
#forum-ui-v1 .mechanic-card{
  border-radius:20px !important;
  padding:15px !important;
  background:
    linear-gradient(135deg,rgba(8,47,73,.55),rgba(8,15,27,.95)) !important;
  border:1px solid rgba(34,211,238,.14) !important;
}

#forum-ui-v1 .mechanic-name{
