    font-size:1.28rem !important;
  }

  #forum-ui-v1 .forum-content{
    padding-left:9px !important;
    padding-right:9px !important;
  }
}
</style>


<style id="ICON-CLEAN-V1">
/* =========================================
   ICON CLEAN V1
   حذف ایموجی‌های انجمن + آیکون‌های SVG/CSS
========================================= */

/* عنوان انجمن */
#forum-ui-v1 .forum-title-icon{
  position:relative;
  font-size:0!important;
}

#forum-ui-v1 .forum-title-icon::after{
  content:"";
  position:absolute;
  width:22px;
  height:12px;
  left:50%;
  top:50%;
  transform:translate(-50%,-45%);
  border:2px solid #fff;
  border-radius:5px 5px 3px 3px;
  box-shadow:
    -8px 9px 0 -6px #fff,
     8px 9px 0 -6px #fff;
}

/* ناوبری */
