  display:flex!important;
  align-items:center!important;
  gap:6px!important;
}

#forum-ui-v1 .forum-category::before{
  content:"";
  width:14px;
  height:14px;
  display:block;
  background-repeat:no-repeat;
  background-position:center;
  background-size:contain;
  opacity:.8;
}

#forum-ui-v1 .forum-category:nth-child(1)::before{
  content:"";
  width:0;
}

#forum-ui-v1 .forum-category:nth-child(1)::after{
