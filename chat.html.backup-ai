}

/* صفحه */

body.forum-ai-open #chat-window{
  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(14,165,233,.10),
      transparent 32%
    ),
    #05080d!important;
}

/* NAV */

body.forum-ai-open #chat-window > .ai-page-tabs{
  margin:8px 10px 0!important;
  height:44px!important;
  padding:3px!important;

  border-radius:13px!important;

  background:rgba(12,18,28,.92)!important;
  border:1px solid rgba(255,255,255,.07)!important;

  box-shadow:
    0 6px 25px rgba(0,0,0,.22)!important;
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab{
  height:36px!important;
  border-radius:10px!important;

  font-size:0!important;
  color:#718096!important;
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab::after{
  font-size:10px!important;
  font-weight:800!important;
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab:nth-child(1)::after{
  content:"انجمن";
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab:nth-child(2)::after{
  content:"دستیار";
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab:nth-child(3)::after{
  content:"گفتگوی عمومی";
}

body.forum-ai-open #chat-window > .ai-page-tabs .forum-tab.active{
  background:#111c2b!important;
  color:#f8fafc!important;

  box-shadow:
    inset 0 0 0 1px rgba(56,189,248,.14)!important;
}

/* پیام‌ها */

body.forum-ai-open #chat-messages{
  padding:
    16px 11px
    12px!important;

  gap:8px!important;
}

/* AI */

body.forum-ai-open #chat-messages .msg.expert{

  max-width:88%!important;

  padding:10px 12px!important;

  border-radius:
    13px 13px 13px 4px!important;

  background:
    #0b121d!important;

  border:
    1px solid rgba(148,163,184,.09)!important;

  color:#d7e2ef!important;

  font-size:12px!important;
  line-height:1.85!important;

  box-shadow:
    0 5px 18px rgba(0,0,0,.16)!important;
}

/* User */

body.forum-ai-open #chat-messages .msg.user{

  max-width:78%!important;

  padding:9px 12px!important;

  border-radius:
    13px 13px 4px 13px!important;

  background:
    linear-gradient(
      135deg,
      #075985,
      #155e9e
    )!important;

  border:
    1px solid rgba(125,211,252,.12)!important;

  font-size:12px!important;
  line-height:1.8!important;

  box-shadow:
    0 5px 18px rgba(0,0,0,.18)!important;
}

/* پیشنهادها */

body.forum-ai-open #chat-v5-prompts{

  padding:
    7px 10px!important;

  gap:6px!important;

  background:transparent!important;
}

body.forum-ai-open .chat-v5-prompt{

  min-height:31px!important;

  padding:
    0 11px!important;

  border-radius:9px!important;

  background:
    #0b121d!important;

  border:
    1px solid rgba(148,163,184,.10)!important;

  color:#94a3b8!important;

  font-size:9px!important;

  box-shadow:none!important;

  transition:
    .15s ease!important;
}

body.forum-ai-open .chat-v5-prompt:active{

  transform:scale(.96)!important;

  background:#101c2b!important;
}

/* INPUT */

body.forum-ai-open #chat-window .chat-input-area{

  margin:
    0 9px
    8px!important;

  padding:
    5px!important;

  min-height:52px!important;

  border-radius:15px!important;

  background:
    #0a111b!important;

  border:
    1px solid rgba(148,163,184,.10)!important;

  box-shadow:
    0 8px 28px rgba(0,0,0,.28)!important;
}

body.forum-ai-open #chat-input{

  height:40px!important;

  padding:
    0 11px!important;

  border-radius:11px!important;

  background:
    transparent!important;

  color:#f1f5f9!important;

  font-size:12px!important;
}

body.forum-ai-open #chat-input::placeholder{
  color:#536174!important;
}

/* SEND */

body.forum-ai-open #chat-send{

  width:38px!important;
  min-width:38px!important;
  max-width:38px!important;

  height:38px!important;

  border-radius:11px!important;

  background:
    #1683b8!important;

  box-shadow:
    0 4px 14px rgba(14,165,233,.18)!important;

  font-size:15px!important;

  transition:
    transform .12s ease,
    background .12s ease!important;
}

body.forum-ai-open #chat-send:active{

  transform:
    scale(.91)!important;

  background:
    #0e7490!important;
}

/* موبایل کوچک */

@media(max-width:390px){

  body.forum-ai-open #chat-window > .ai-page-tabs{
    margin:
      7px 8px 0!important;
  }

  body.forum-ai-open #chat-messages{
    padding-left:8px!important;
    padding-right:8px!important;
  }

  body.forum-ai-open #chat-window .chat-input-area{
    margin-left:7px!important;
    margin-right:7px!important;
    margin-bottom:7px!important;
  }

}

</style>











<style id="AI-SCROLL-ONE-FIX">
body.forum-ai-open{
  height:100dvh!important;
  overflow:hidden!important;
}

body.forum-ai-open #chat-window{
  position:fixed!important;
  inset:0!important;
  width:100vw!important;
  height:100dvh!important;
  display:flex!important;
  flex-direction:column!important;
  overflow:hidden!important;
}

body.forum-ai-open #chat-window > .ai-page-tabs{
  flex:0 0 auto!important;
}

body.forum-ai-open #chat-window #chat-messages{
  flex:1 1 0!important;
  min-height:0!important;
  height:0!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  -webkit-overflow-scrolling:touch!important;
  touch-action:pan-y!important;
  overscroll-behavior-y:contain!important;
}

body.forum-ai-open #chat-window .chat-input-area{
  flex:0 0 auto!important;
}
</style>

<style id="AI-SCROLL-TEST-FIX">
body.forum-ai-open #chat-window #chat-messages{
  flex:1 1 0 !important;
  height:0 !important;
  min-height:0 !important;
  max-height:none !important;
  overflow-y:auto !important;
  overflow-x:hidden !important;
  touch-action:pan-y !important;
  -webkit-overflow-scrolling:touch !important;
}
</style>

<style id="AI-MESSAGE-BOTTOM-SPACING">
body.forum-ai-open #chat-window #chat-messages{
  padding-bottom:calc(90px + env(safe-area-inset-bottom)) !important;
  scroll-padding-bottom:90px !important;
}
</style>

<style id="AI-MESSAGES-PRO-V2">

/* ================================
   پیام‌های دستیار — PRO
================================ */

body.forum-ai-open #chat-messages .msg{
  position:relative!important;
  animation:aiMsgIn .22s ease-out both!important;
  word-break:break-word!important;
}

@keyframes aiMsgIn{
  from{
    opacity:0;
    transform:translateY(7px) scale(.98);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

/* AI */
body.forum-ai-open #chat-messages .msg.expert{
  position:relative!important;
  margin-left:2px!important;
  padding:12px 14px 12px 16px!important;
  border-radius:17px 17px 17px 5px!important;
  background:
    linear-gradient(145deg,#101b2a,#0b131f)!important;
  border:1px solid rgba(56,189,248,.12)!important;
  color:#e2e8f0!important;
  box-shadow:
    0 7px 24px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.025)!important;
}

/* خط نور کنار پیام AI */
body.forum-ai-open #chat-messages .msg.expert::before{
  content:""!important;
  position:absolute!important;
  left:-1px!important;
  top:10px!important;
  bottom:10px!important;
  width:2px!important;
  border-radius:4px!important;
  background:linear-gradient(
    180deg,
    #22d3ee,
    #2563eb
  )!important;
  opacity:.8!important;
}

/* USER */
body.forum-ai-open #chat-messages .msg.user{
  margin-right:2px!important;
  padding:10px 14px!important;
  border-radius:17px 17px 5px 17px!important;
  background:
    linear-gradient(135deg,#075985,#1d4ed8)!important;
  border:1px solid rgba(125,211,252,.15)!important;
  color:#f8fafc!important;
  box-shadow:
    0 7px 22px rgba(0,0,0,.20)!important;
}

/* ================================
   INPUT — PRO
================================ */

body.forum-ai-open #chat-window .chat-input-area{
  position:relative!important;
  gap:7px!important;
  padding:6px!important;
  border-radius:17px!important;
  background:
    linear-gradient(
      145deg,
      rgba(15,25,39,.98),
      rgba(8,15,25,.98)
    )!important;
  border:1px solid rgba(56,189,248,.10)!important;
  box-shadow:
    0 10px 32px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.025)!important;
}

/* خود ورودی */
body.forum-ai-open #chat-input{
  height:42px!important;
  border-radius:12px!important;
  background:rgba(255,255,255,.025)!important;
  border:1px solid rgba(255,255,255,.035)!important;
  transition:
    border-color .18s ease,
    background .18s ease,
    box-shadow .18s ease!important;
}

/* وقتی کاربر روی ورودی می‌زند */
body.forum-ai-open #chat-input:focus{
  background:rgba(14,165,233,.045)!important;
  border-color:rgba(34,211,238,.25)!important;
  box-shadow:0 0 0 3px rgba(34,211,238,.045)!important;
}

/* دکمه ارسال */
body.forum-ai-open #chat-send{
  position:relative!important;
  width:40px!important;
  min-width:40px!important;
  height:40px!important;
  border-radius:12px!important;
  background:
    linear-gradient(135deg,#06b6d4,#2563eb)!important;
  box-shadow:
    0 5px 16px rgba(37,99,235,.25)!important;
  transition:
    transform .12s ease,
    filter .12s ease!important;
}

body.forum-ai-open #chat-send:active{
  transform:scale(.90)!important;
  filter:brightness(.88)!important;
}

/* ================================
   موبایل کوچک
================================ */

@media(max-width:390px){

  body.forum-ai-open #chat-window .chat-input-area{
    padding:5px!important;
    border-radius:15px!important;
  }

  body.forum-ai-open #chat-input{
    height:40px!important;
  }

  body.forum-ai-open #chat-send{
    width:38px!important;
    min-width:38px!important;
    height:38px!important;
  }

}

</style>

<style id="AI-TYPING-INDICATOR-V1">

.ai-typing-indicator{
  display:flex!important;
  align-items:center!important;
  gap:5px!important;
  width:max-content!important;
  padding:11px 14px!important;
  margin:2px 0!important;
  border-radius:16px 16px 16px 5px!important;
  background:#101b2a!important;
  border:1px solid rgba(56,189,248,.12)!important;
  box-shadow:0 6px 20px rgba(0,0,0,.18)!important;
}

.ai-typing-indicator span{
  width:5px!important;
  height:5px!important;
  border-radius:50%!important;
  background:#38bdf8!important;
  animation:aiTypingDot 1.1s infinite ease-in-out!important;
}

.ai-typing-indicator span:nth-child(2){
  animation-delay:.15s!important;
}

.ai-typing-indicator span:nth-child(3){
  animation-delay:.30s!important;
}

@keyframes aiTypingDot{
  0%,60%,100%{
    opacity:.25;
    transform:translateY(0);
  }
  30%{
    opacity:1;
    transform:translateY(-3px);
  }
}

</style>

<script id="AI-TYPING-INDICATOR-JS">
(function(){

  const messages=document.getElementById('chat-messages');
  if(!messages) return;

  window.showAITyping=function(){

    if(document.getElementById('ai-typing-indicator')) return;

    const box=document.createElement('div');

    box.id='ai-typing-indicator';
    box.className='ai-typing-indicator';

    box.innerHTML=
      '<span></span><span></span><span></span>';

    messages.appendChild(box);

    messages.scrollTop=messages.scrollHeight;
  };

  window.hideAITyping=function(){

    const box=document.getElementById('ai-typing-indicator');

    if(box) box.remove();
  };

})();
</script>

