<div id="chat-window">
<div class="forum-tabs shared-tabs ai-page-tabs">
  <button class="forum-tab" type="button" data-shared-page="forum">💬 انجمن</button>
  <button class="forum-tab active" type="button" data-shared-page="ai">🤖 دستیار</button>
  <button class="forum-tab" type="button" data-shared-page="public">👥 عمومی</button>
</div>


  <div id="chat-messages">
    <div class="msg expert">سلام! چطور می‌توانم کمک کنم؟</div>
  </div>
  

<div class="chat-input-area">
    <input type="text" id="chat-input" placeholder="پیام...">
    <button id="chat-send" type="button">➤</button>
  </div>
</div>

<script id="supabase-chat-script">
(function () {
  const SUPABASE_URL = 'https://zpobmwhvhqjcqmaoqtxq.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_ruoLdqEOaFEuQjPt5e0Huw_KwKAOp4T';
  const API_URL = SUPABASE_URL + '/rest/v1/messages';

  const fab = document.getElementById('chat-fab');
  const chatWindow = document.getElementById('chat-window');
  const input = document.getElementById('chat-input');
  const sendButton = document.getElementById('chat-send');
  const messages = document.getElementById('chat-messages');

  if (!fab || !chatWindow || !input || !sendButton || !messages) return;

  function addMessage(text, type) {
    const message = document.createElement('div');
    message.className = 'msg ' + type;
    message.textContent = text;
    messages.appendChild(message);
    messages.scrollTop = messages.scrollHeight;
  }

  function renderMessages(data) {
    messages.innerHTML = '';
    if (!data || data.length === 0) {
      addMessage('سلام! چطور می‌توانم کمک کنم؟', 'expert');
      return;
    }
    data.forEach(function (item) {
      addMessage(item.text, item.sender === 'expert' ? 'expert' : 'user');
    });
  }

  let lastMessagesJSON = '';

  async function loadMessages() {
    try {
      const response = await fetch(
        API_URL + '?select=id,text,sender,created_at&order=created_at.asc',
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY } }
      );
      if (!response.ok) throw new Error('خطا در دریافت پیام‌ها');

      const data = await response.json();
      const json = JSON.stringify(data);

      if (json !== lastMessagesJSON) {
        lastMessagesJSON = json;
        renderMessages(data);
      }

    } catch (error) {
      console.error(error);
    }
  }

  async function sendMessage(event) {
    if (event) event.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    sendButton.disabled = true;
    input.value = '';

    try {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify({ text: text, sender: 'user' })
      });

      if (!response.ok) throw new Error('خطا در ارسال پیام');
      await loadMessages();
    } catch (error) {
      console.error(error);
      addMessage('ارسال پیام ناموفق بود. اتصال اینترنت را بررسی کنید.', 'expert');
      input.value = text;
    } finally {
      sendButton.disabled = false;
      input.focus();
    }
  }

  fab.onclick = function () {
    chatWindow.classList.toggle('active');
    if (chatWindow.classList.contains('active')) loadMessages();
  };

  sendButton.onclick = sendMessage;
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter') sendMessage(event);
  });

  setInterval(function () {
    if (chatWindow.classList.contains('active')) loadMessages();
  }, 5000);
})();
</script>





<script id="SHARED-TABS-CONTROLLER">
(function () {
  function initSharedTabs() {
    const forum = document.getElementById('forum-ui-v1');
    const chat = document.getElementById('chat-window');
    const pub = document.getElementById('public-chat-page');

    if (!forum || !chat || !pub) {
      console.error('SHARED TABS: page missing');
      return;
    }

    function setActive(page) {
      document.querySelectorAll('.shared-tabs [data-shared-page]')
        .forEach(function (btn) {
          btn.classList.toggle(
            'active',
            btn.dataset.sharedPage === page
          );
        });
    }

    function showForum() {
      document.body.classList.remove('forum-ai-open', 'public-chat-open');

      forum.style.removeProperty('display');
      forum.style.removeProperty('visibility');
      forum.style.removeProperty('opacity');

      chat.classList.remove('active');
      chat.style.setProperty('display', 'none', 'important');

      pub.style.setProperty('display', 'none', 'important');

      setActive('forum');
    }

    function showAI() {
      document.body.classList.remove('public-chat-open');
      document.body.classList.add('forum-ai-open');

      forum.style.setProperty('display', 'none', 'important');
      pub.style.setProperty('display', 'none', 'important');

      chat.classList.add('active');
      chat.style.setProperty('display', 'flex', 'important');
      chat.style.setProperty('visibility', 'visible', 'important');
      chat.style.setProperty('opacity', '1', 'important');

      setActive('ai');
    }

    function showPublic() {
      document.body.classList.remove('forum-ai-open');
      document.body.classList.add('public-chat-open');

      forum.style.setProperty('display', 'none', 'important');

      chat.classList.remove('active');
      chat.style.setProperty('display', 'none', 'important');

      pub.style.setProperty('display', 'flex', 'important');
      pub.style.setProperty('visibility', 'visible', 'important');
      pub.style.setProperty('opacity', '1', 'important');

      setActive('public');
    }

    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.shared-tabs [data-shared-page]');
      if (!btn) return;

      e.preventDefault();

      const page = btn.dataset.sharedPage;

      console.log('SHARED TAB CLICK:', page, btn.textContent.trim());

      if (page === 'forum') showForum();
      else if (page === 'ai') showAI();
      else if (page === 'public') showPublic();
    }, true);

    showForum();

    console.log('SHARED TABS CONTROLLER: READY');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSharedTabs);
  } else {
    initSharedTabs();
  }
})();
</script>


