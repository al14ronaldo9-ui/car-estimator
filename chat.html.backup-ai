<style id="AI-REDESIGN-V1">
/* =========================================
   AI REDESIGN V1
   فقط ظاهر دستیار — بدون تغییر JS
========================================= */

body.forum-ai-open{
  background:#050a12!important;
}

/* صفحه اصلی دستیار */
body.forum-ai-open #chat-window{
  background:
    radial-gradient(circle at 85% 0%,rgba(6,182,212,.10),transparent 32%),
    radial-gradient(circle at 10% 45%,rgba(37,99,235,.07),transparent 30%),
    linear-gradient(180deg,#050a12 0%,#07111d 100%)!important;
}

/* نوار ناوبری */
body.forum-ai-open #chat-window > .shared-tabs{
  flex:none!important;
  margin:10px 12px 0!important;
  padding:4px!important;
  height:46px!important;
  border-radius:15px!important;
  background:rgba(8,15,28,.90)!important;
  border:1px solid rgba(148,163,184,.10)!important;
  box-sizing:border-box!important;
  backdrop-filter:blur(18px);
}

/* دکمه‌های ناوبری */
body.forum-ai-open #chat-window > .shared-tabs .forum-tab{
  height:38px!important;
  border-radius:11px!important;
  font-size:0!important;
  color:#7d8ba3!important;
  font-weight:800!important;
}

body.forum-ai-open #chat-window > .shared-tabs .forum-tab:nth-child(1)::after{
  content:"انجمن";
  font-size:.68rem;
}

body.forum-ai-open #chat-window > .shared-tabs .forum-tab:nth-child(2)::after{
  content:"دستیار";
  font-size:.68rem;
}

body.forum-ai-open #chat-window > .shared-tabs .forum-tab:nth-child(3)::after{
  content:"گفتگوی عمومی";
  font-size:.68rem;
}

body.forum-ai-open #chat-window > .shared-tabs .forum-tab.active{
  color:#fff!important;
  background:linear-gradient(135deg,#075985,#1d4ed8)!important;
  box-shadow:0 5px 18px rgba(37,99,235,.22)!important;
}

/* هدر */
body.forum-ai-open #chat-window .chat-header{
  flex:none!important;
  height:82px!important;
  min-height:82px!important;
  margin:10px 12px 0!important;
  padding:14px 58px 14px 16px!important;
  border-radius:20px!important;
  background:
    linear-gradient(135deg,rgba(8,47,73,.70),rgba(8,15,27,.94))!important;
  border:1px solid rgba(34,211,238,.14)!important;
  box-shadow:0 12px 35px rgba(0,0,0,.22)!important;
  box-sizing:border-box!important;
}

/* عنوان */
body.forum-ai-open #chat-window .chat-header h3{
  font-size:16px!important;
  font-weight:950!important;
  color:#f8fafc!important;
}

/* زیرعنوان اگر وجود داشته باشد */
body.forum-ai-open #chat-window .chat-header p{
  margin-top:4px!important;
  color:#7dd3fc!important;
  font-size:9px!important;
}

/* دکمه برگشت کوچک و تمیز */
body.forum-ai-open #chat-window #forum-back-button{
  width:36px!important;
  min-width:36px!important;
  max-width:36px!important;
  height:36px!important;
  min-height:36px!important;
  padding:0!important;
  border-radius:11px!important;
  font-size:0!important;
  background:rgba(255,255,255,.06)!important;
  border:1px solid rgba(255,255,255,.12)!important;
  box-shadow:none!important;
}

/* اگر متن برگشت داخل span/b وجود داشت، حذف ظاهرش */
body.forum-ai-open #chat-window #forum-back-button span{
  display:none!important;
}

body.forum-ai-open #chat-window #forum-back-button b{
  font-size:18px!important;
}

/* محدوده پیام‌ها */
body.forum-ai-open #chat-messages{
  flex:1!important;
  min-height:0!important;
  overflow-y:auto!important;
  padding:16px 12px 12px!important;
  display:flex!important;
  flex-direction:column!important;
  gap:10px!important;
  scrollbar-width:none!important;
}

body.forum-ai-open #chat-messages::-webkit-scrollbar{
  display:none!important;
}

/* پیام کاربر */
body.forum-ai-open #chat-messages .msg.user{
  align-self:flex-end!important;
  max-width:82%!important;
  padding:10px 13px!important;
  border-radius:16px 16px 4px 16px!important;
  background:linear-gradient(135deg,#075985,#1d4ed8)!important;
  color:#fff!important;
  border:1px solid rgba(125,211,252,.12)!important;
  font-size:12px!important;
  line-height:1.8!important;
  box-shadow:0 8px 22px rgba(0,0,0,.18)!important;
}

/* پیام هوش مصنوعی */
body.forum-ai-open #chat-messages .msg.expert{
  align-self:flex-start!important;
  max-width:88%!important;
  padding:12px 14px!important;
  border-radius:16px 16px 16px 4px!important;
  background:linear-gradient(145deg,rgba(15,27,43,.96),rgba(9,17,29,.96))!important;
  color:#dbeafe!important;
  border:1px solid rgba(148,163,184,.11)!important;
  font-size:12px!important;
  line-height:1.9!important;
  box-shadow:0 8px 25px rgba(0,0,0,.16)!important;
}

/* پیشنهادهای آماده */
body.forum-ai-open #chat-v5-prompts{
  flex:none!important;
  display:flex!important;
  gap:7px!important;
  overflow-x:auto!important;
  padding:8px 12px!important;
  scrollbar-width:none!important;
}

