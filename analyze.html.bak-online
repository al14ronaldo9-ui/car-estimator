function getVehicleSelection() {
  const groupEl = document.getElementById('brandGroupSelect');
  const modelEl = document.getElementById('vehicleModelSelect');
  const yearEl = document.getElementById('vehicleYearSelect');
  if (!groupEl || !modelEl || !yearEl) return null;

  const group = VEHICLE_GROUPS[groupEl.value];
  const model = group?.models?.[modelEl.value];
  const year = Number(yearEl.value);
  if (!group || !model || !year) return null;

  return {
    groupKey: groupEl.value,
    modelKey: modelEl.value,
    groupLabel: group.label,
    modelLabel: model.label,
    year,
    yearLabel: yearEl.options[yearEl.selectedIndex]?.textContent || String(year),
    multiplier: group.multiplier * model.multiplier
  };
}

function updateVehicleYears() {
  const modelEl = document.getElementById('vehicleModelSelect');
  const yearEl = document.getElementById('vehicleYearSelect');
  if (!modelEl || !yearEl) return;

  yearEl.innerHTML = '';
  const placeholder = document.createElement('option');
  placeholder.value = '';
  placeholder.textContent = modelEl.value ? 'انتخاب سال ساخت...' : 'ابتدا مدل خودرو را انتخاب کنید';
  yearEl.appendChild(placeholder);

  if (!modelEl.value) {
    yearEl.disabled = true;
    window.updateAnalyzeButton();
    return;
  }

  for (let year = 1405; year >= 1380; year--) {
    const option = document.createElement('option');
    option.value = String(year);
    option.textContent = String(year);
    yearEl.appendChild(option);
  }

  yearEl.disabled = false;
  window.updateAnalyzeButton();
}

function updateVehicleModels() {
  const groupEl = document.getElementById('brandGroupSelect');
  const modelEl = document.getElementById('vehicleModelSelect');
  const yearEl = document.getElementById('vehicleYearSelect');
  if (!groupEl || !modelEl || !yearEl) return;

  modelEl.innerHTML = '';
  yearEl.innerHTML = '';

  const group = VEHICLE_GROUPS[groupEl.value];
  const modelPlaceholder = document.createElement('option');
  modelPlaceholder.value = '';
  modelPlaceholder.textContent = group ? 'انتخاب کنید...' : 'ابتدا دسته خودرو را انتخاب کنید';
  modelEl.appendChild(modelPlaceholder);

  if (!group) {
    modelEl.disabled = true;
    const yearPlaceholder = document.createElement('option');
    yearPlaceholder.value = '';
    yearPlaceholder.textContent = 'ابتدا مدل خودرو را انتخاب کنید';
    yearEl.appendChild(yearPlaceholder);
    yearEl.disabled = true;
    window.updateAnalyzeButton();
    return;
  }

  for (const [key, model] of Object.entries(group.models)) {
    const option = document.createElement('option');
    option.value = key;
    option.textContent = model.label;
    modelEl.appendChild(option);
  }

  modelEl.disabled = false;
  const yearPlaceholder = document.createElement('option');
  yearPlaceholder.value = '';
  yearPlaceholder.textContent = 'ابتدا مدل خودرو را انتخاب کنید';
  yearEl.appendChild(yearPlaceholder);
  yearEl.disabled = true;
  window.updateAnalyzeButton();
}

function getYearFactor(year) {
  const y = Number(year);
  if (!y) return 1;
  // اثر سال ساخت عمداً محدود است؛ قطعه قدیمی لزوماً ارزان‌تر نیست.
  return Math.max(0.95, Math.min(1.05, 0.98 + (y - 1390) * 0.002));
}

function getDamageSeverity(result) {
  const coverage = Math.min(1, Math.max(0, Number(result.damageCoverage) || 0));
  const maskFill = Math.min(1, Math.max(0, Number(result.areaFraction) || 0));

  // اندازه جعبه، شدت/گستردگی آسیب را بهتر از confidence نشان می‌دهد.
  // maskFill فقط یک عامل کمکی است و نباید به‌تنهایی قیمت را تعیین کند.
  const sizeScore = Math.sqrt(Math.min(1, coverage / 0.12));
  return Math.min(1, Math.max(0.15, 0.15 + sizeScore * 0.65 + maskFill * 0.20));
}

function roundMoney(value) {
  return Math.max(0, Math.round(value / 100000) * 100000);
}

function calculateDamageCost(result, vehicle) {
  const rule = DAMAGE_PRICING[result.classId];
  if (!rule) return null;

  const severity = getDamageSeverity(result);
  const modelFactor = vehicle?.multiplier || 1;
  const yearFactor = getYearFactor(vehicle?.year);

  // قطعه برای موارد تعویضی تقریباً ثابت است؛ اجرت با شدت آسیب تغییر می‌کند.
  const laborFactor = 0.45 + severity * 0.55;
  const repairFactor = 0.35 + severity * 0.65;
  const partFactor = rule.replacement ? 1 : (0.25 + severity * 0.75);

  const partMin = roundMoney(rule.part[0] * modelFactor * yearFactor * partFactor);
  const partMax = roundMoney(rule.part[1] * modelFactor * yearFactor * partFactor);
  const laborMin = roundMoney(rule.labor[0] * modelFactor * laborFactor);
  const laborMax = roundMoney(rule.labor[1] * modelFactor * laborFactor);
  const materialMin = roundMoney(rule.material[0] * modelFactor * repairFactor);
  const materialMax = roundMoney(rule.material[1] * modelFactor * repairFactor);

  return {
    severity,
    partMin,
    partMax: Math.max(partMin, partMax),
    laborMin: Math.max(100000, laborMin),
    laborMax: Math.max(laborMin, laborMax),
    repairMin: Math.max(100000, laborMin + materialMin),
    repairMax: Math.max(laborMax + materialMax, laborMin + materialMin),
    totalMin: partMin + laborMin + materialMin,
    totalMax: Math.max(partMin + laborMin + materialMin, partMax + laborMax + materialMax),
    method: rule.label
  };
}

let isAnalyzing = false;

window.updateAnalyzeButton = function () {
  const ready = !!currentImage && !!getVehicleSelection();
  if (analyzeButton) analyzeButton.disabled = isAnalyzing || !ready;
};


// ===== FIX: انتخاب خودرو مستقل =====
(function () {
  const g = document.getElementById('brandGroupSelect');
  const m = document.getElementById('vehicleModelSelect');
  const y = document.getElementById('vehicleYearSelect');

  if (!g || !m || !y) return;

  g.disabled = false;

  g.addEventListener('change', function () {
    const group = VEHICLE_GROUPS[this.value];

    m.innerHTML = '<option value="">انتخاب مدل...</option>';
    y.innerHTML = '<option value="">ابتدا مدل خودرو را انتخاب کنید</option>';

    if (!group) {
      m.disabled = true;
      y.disabled = true;
      return;
    }

    Object.entries(group.models).forEach(([key, model]) => {
      const o = document.createElement('option');
      o.value = key;
      o.textContent = model.label;
      m.appendChild(o);
    });

    m.disabled = false;
    y.disabled = true;
  });

  m.addEventListener('change', function () {
    if (!this.value) {
      y.disabled = true;
      y.innerHTML = '<option value="">ابتدا مدل خودرو را انتخاب کنید</option>';
      return;
    }

    y.innerHTML = '<option value="">انتخاب سال ساخت...</option>';

    for (let year = 1405; year >= 1380; year--) {
      const o = document.createElement('option');
      o.value = String(year);
      o.textContent = String(year);
      y.appendChild(o);
    }

    y.disabled = false;
  });
})();


