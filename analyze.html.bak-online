<style id="layout-isolation-v3">
/* Final responsive isolation: estimator page owns the viewport. */
html, body {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
}
body {
  display: flex !important;
  justify-content: flex-start !important;
  align-items: center !important;
  flex-direction: column !important;
  padding: 16px 12px 96px !important;
}
body > main {
  width: min(100%, 720px) !important;
  max-width: 720px !important;
  margin: 0 auto !important;
}
#chat-window {
  display: none !important;
}
#chat-window.active {
  display: flex !important;
}
#chat-fab {
  display: none !important;
}
.options-row {
  display: flex !important;
  width: 100% !important;
}
.options-row > div {
  min-width: 0 !important;
}
@media (max-width: 700px) {
  body {
    padding: 10px 10px 92px !important;
  }
  body > main {
    width: 100% !important;
    max-width: 100% !important;
  }
  .card {
    width: 100% !important;
    max-width: 100% !important;
  }
  .options-row {
    flex-direction: column !important;
  }
  .options-row > div {
    width: 100% !important;
    flex: 1 1 auto !important;
  }
}
</style>
