// ===== اتصال رویدادهای انتخاب خودرو =====
const brandGroupSelect = document.getElementById('brandGroupSelect');
const vehicleModelSelect = document.getElementById('vehicleModelSelect');
if (brandGroupSelect) brandGroupSelect.addEventListener('change', function(){ updateVehicleModels(); });
if (vehicleModelSelect) vehicleModelSelect.addEventListener('change', updateVehicleYears);
const vehicleYearSelect = document.getElementById("vehicleYearSelect"); if (vehicleYearSelect) vehicleYearSelect.addEventListener("change", window.updateAnalyzeButton);
if (brandGroupSelect) updateVehicleModels();

function updateVehicleResultInfo(vehicle) {
    const nameEl = document.getElementById('resultVehicleName');
    const yearEl = document.getElementById('resultVehicleYear');

    if (!nameEl || !yearEl) return;

    if (vehicle) {
        nameEl.textContent =
            vehicle.groupLabel + ' - ' + vehicle.modelLabel;
        yearEl.textContent =
            vehicle.yearLabel;
    } else {
        nameEl.textContent = '-';
        yearEl.textContent = '-';
    }
}

function showResultsWithOptions(results) {
  const vehicle = getVehicleSelection();
  updateVehicleResultInfo(vehicle);

  const groups = {};
  let totalMin = 0;
  let totalMax = 0;

  for (const result of results) {
    const cost = calculateDamageCost(result, vehicle);
    if (!cost) continue;

    const key = result.classId;
    if (!groups[key]) {
      groups[key] = {
        count: 0,
        scoreSum: 0,
        partMin: 0,
        partMax: 0,
        laborMin: 0,
        laborMax: 0,
        repairMin: 0,
        repairMax: 0,
        totalMin: 0,
        totalMax: 0,
        severitySum: 0,
        method: cost.method
      };
    }

    const group = groups[key];
    group.count += 1;
    group.scoreSum += result.score;
    group.severitySum += cost.severity;
    group.partMin += cost.partMin;
    group.partMax += cost.partMax;
    group.laborMin += cost.laborMin;
    group.laborMax += cost.laborMax;
    group.repairMin += cost.repairMin;
    group.repairMax += cost.repairMax;
    group.totalMin += cost.totalMin;
    group.totalMax += cost.totalMax;

    totalMin += cost.totalMin;
    totalMax += cost.totalMax;
  }

  dbg(
    'خودرو: ' +
      (vehicle ? `${vehicle.groupLabel} - ${vehicle.modelLabel} - سال ${vehicle.yearLabel}` : 'نامشخص') +
      ' | آسیب‌ها: ' +
      results.length
  );

  resultBody.innerHTML = '';
  let hasAny = false;

  for (let classId = 0; classId < NUM_CLASSES; classId++) {
    const group = groups[classId];
    if (!group) continue;
    hasAny = true;

    const avgScore = Math.round((group.scoreSum / group.count) * 100);
    const avgSeverity = group.severitySum / group.count;
    const severityLabel = avgSeverity < 0.42 ? 'خفیف' : avgSeverity < 0.68 ? 'متوسط' : 'شدید';
    const color = CLASS_COLORS[classId];
    const tr = document.createElement('tr');

    const money = (min, max) =>
      `${min.toLocaleString('fa-IR')} تا ${max.toLocaleString('fa-IR')}`;

    tr.innerHTML = `
      <td>
        <span class="dot" style="background:rgb(${color[0]},${color[1]},${color[2]})"></span>
        ${CLASS_NAMES[classId]}
        <small style="display:block;color:#94a3b8;margin-top:3px">${group.method} — ${severityLabel}</small>
      </td>
      <td style="text-align:center;font-weight:700">${group.count.toLocaleString('fa-IR')}</td>
      <td style="text-align:center;font-weight:700;color:#a78bfa">${avgScore}٪</td>
      <td style="text-align:left;font-weight:700;color:#38bdf8">${money(group.partMin, group.partMax)}</td>
      <td style="text-align:left;font-weight:700;color:#f59e0b">${money(group.laborMin, group.laborMax)}</td>
      <td style="text-align:left;font-weight:700;color:#22c55e">${money(group.repairMin, group.repairMax)}</td>
      <td style="text-align:left;font-weight:700;color:#38bdf8">${money(group.totalMin, group.totalMax)}</td>
    `;

    resultBody.appendChild(tr);
  }

  if (!hasAny) {
    resultBody.innerHTML =
      '<tr><td colspan="7" style="text-align:center;color:var(--text-muted)">آسیبی با اطمینان کافی تشخیص داده نشد.</td></tr>';
  }

  totalCostEl.textContent =
    `${totalMin.toLocaleString('fa-IR')} تا ${totalMax.toLocaleString('fa-IR')} تومان`;

  const note = document.getElementById('pricingNote');
  if (note) {
    note.textContent = `به‌روزرسانی قیمت: ${PRICING_META.updated} — ${PRICING_META.note}`;
  }

  resultCard.classList.remove('hidden');
  sessionStorage.setItem('carEstimatorResult', resultCard.innerHTML);
  resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ===== پچ کردن کلیک دکمه آنالیز =====
const originalClickHandler = analyzeButton.click;
analyzeButton.addEventListener('click', async function () {
    if (isAnalyzing || !currentImage) return;

    isAnalyzing = true;
    window.updateAnalyzeButton();
    showLoading();

    try {
        setStatus('آماده‌سازی عکس...');
        await new Promise(resolve => setTimeout(resolve, 100));

        setStatus('اعتبارسنجی تصویر خودرو...');
        const gate = await validateCarImage(currentImage);
        if (!gate.is_car || Number(gate.confidence || 0) < 0.60) {
            throw new Error('این تصویر به اندازه کافی شبیه خودروی واقعی تشخیص داده نشد؛ لطفاً عکس واضح از خودرو انتخاب کنید.');
        }

        setStatus('تحلیل تخصصی خسارت با هوش مصنوعی...');

        const aiCanvas = document.createElement('canvas');
        aiCanvas.width = Math.min(currentImage.naturalWidth, 1600);
        aiCanvas.height = Math.round(currentImage.naturalHeight * (aiCanvas.width / currentImage.naturalWidth));
        aiCanvas.getContext('2d').drawImage(
            currentImage, 0, 0, aiCanvas.width, aiCanvas.height
        );

        const aiResponse = await fetch(
            'https://zpobmwhvhqjcqmaoqtxq.supabase.co/functions/v1/ai-car-analysis',
            {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    mode: 'specialized',
                    image: aiCanvas.toDataURL('image/jpeg', 0.82)
                })
            }
        );

        const aiData = await aiResponse.json();

        if (!aiResponse.ok) {
            throw new Error(aiData.error || 'تحلیل آنلاین ناموفق بود.');
        }

        let aiRaw =
            aiData?.choices?.[0]?.message?.content ||
            aiData?.report ||
            aiData;

        if (typeof aiRaw === 'string') {
            aiRaw = aiRaw
                .replace(/^```json\s*/i, '')
                .replace(/\s*```$/i, '')
                .trim();

            try {
                aiRaw = JSON.parse(aiRaw);
            } catch (_) {}
        }

        if (!aiRaw || aiRaw.is_car !== true) {
            throw new Error('این تصویر خودرو نیست.');
        }

        const aiDamages = Array.isArray(aiRaw.damages)
            ? aiRaw.damages
            : [];

        const classMap = {
            'فرورفتگی بدنه': 0,
            'خط و خش عمیق': 1,
            'ترک‌خوردگی': 2,
            'شیشه شکسته': 3,
            'شکستگی چراغ': 4,
            'لاستیک پنچر': 5
        };

        const results = aiDamages.map(d => {
            const classId = classMap[d.part] ?? classMap[d.damage];

            if (classId === undefined) return null;

            const confidence = Math.max(
                0,
                Math.min(1, Number(d.confidence) || 0.5)
            );

            const severity =
                d.severity === 'زیاد' ? 0.8 :
                d.severity === 'متوسط' ? 0.5 :
                0.25;

            return {
                classId: classId,
                score: confidence,
                damageCoverage: severity * 0.10,
                areaFraction: severity
            };
        }).filter(Boolean);

        window.lastResults = results;

        setStatus('محاسبه هزینه...');

        drawResults(results, currentImage, {
            scale: 1,
            dx: 0,
            dy: 0,
            w: currentImage.naturalWidth,
            h: currentImage.naturalHeight,
            origW: currentImage.naturalWidth,
            origH: currentImage.naturalHeight
        });

        showResultsWithOptions(results);

        if (results.length === 0) {
            setStatus('آسیب قابل اتکایی شناسایی نشد.', 'error');
        } else {
            setStatus('تحلیل تخصصی و برآورد هزینه انجام شد.', 'ok');
        }



    } catch (e) {
        console.error(e);
        setStatus('خطا در تحلیل: ' + e.message, 'error');
    } finally {
        isAnalyzing = false;
        hideLoading();
        window.updateAnalyzeButton();
    }
});

async function validateCarImage(image) {
    const canvas = document.createElement('canvas');
    canvas.width = Math.min(image.naturalWidth, 1280);
    canvas.height = Math.round(image.naturalHeight * (canvas.width / image.naturalWidth));
    const ctx = canvas.getContext('2d');
    ctx.drawImage(image, 0, 0, canvas.width, canvas.height);

    const response = await fetch(
        'https://zpobmwhvhqjcqmaoqtxq.supabase.co/functions/v1/ai-car-analysis',
        {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'car_gate', image: canvas.toDataURL('image/jpeg', 0.72) })
        }
    );

    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'اعتبارسنجی تصویر ناموفق بود.');

    let raw = data?.choices?.[0]?.message?.content || data?.analysis || data;
    if (typeof raw === 'string') {
        raw = raw.replace(/^```json\s*/i, '').replace(/\s*```$/i, '').trim();
        try { raw = JSON.parse(raw); } catch (_) {
            return { is_car: /is_car\s*[:=]\s*true/i.test(raw), confidence: 0.60 };
        }
    }
    return raw || { is_car: false, confidence: 0 };
}

function setupSpecializedAnalyzeButton() {
    const button = document.getElementById('specializedAnalyzeButton');
    if (!button) return;

    button.addEventListener('click', () => {
        if (!currentImage) return;
        try {
            const canvas = document.createElement('canvas');
            canvas.width = Math.min(currentImage.naturalWidth, 1280);
            canvas.height = Math.round(currentImage.naturalHeight * (canvas.width / currentImage.naturalWidth));
            canvas.getContext('2d').drawImage(currentImage, 0, 0, canvas.width, canvas.height);
            sessionStorage.setItem('car_specialized_image', canvas.toDataURL('image/jpeg', 0.78));
            sessionStorage.setItem('car_specialized_results', JSON.stringify(window.lastResults || []));
            window.location.href = 'chat.html?tab=ai&specialized=1';
        } catch (error) {
            console.error(error);
            setStatus('باز کردن دستیار تخصصی ممکن نشد.', 'error');
        }
    });

    window.updateSpecializedButton = () => {
        button.disabled = !currentImage;
    };
    window.updateSpecializedButton();
}

async function copyReportToClipboard() {
    const vehicle = getVehicleSelection();
    let text = 'برآورد هزینه خسارت خودرو:\n';
    if (vehicle) text += `خودرو: ${vehicle.groupLabel} - ${vehicle.modelLabel} - سال ساخت: ${vehicle.yearLabel}\n\n`;
    
    document.querySelectorAll('#resultBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length === 7) {
            text += `- ${cells[0].textContent.trim()}: ${cells[1].textContent.trim()} مورد (اطمینان: ${cells[2].textContent.trim()}) - هزینه: ${cells[3].textContent.trim()}\n`;
        }
    });
    
    const total = document.getElementById('totalCost');
    if (total) text += `\nهزینه کل: ${total.textContent.trim()}\n`;
    
    try {
        await navigator.clipboard.writeText(text);
        setStatus('متن برآورد با موفقیت کپی شد!', 'ok');
    } catch (e) {
        setStatus('خطا در کپی: ' + e.message, 'error');
    }
}

async function shareReport() {
    const vehicle = getVehicleSelection();
    let text = 'برآورد هزینه خسارت خودرو:\n';
    if (vehicle) text += `خودرو: ${vehicle.groupLabel} - ${vehicle.modelLabel} - سال ساخت: ${vehicle.yearLabel}\n\n`;
    
    document.querySelectorAll('#resultBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length === 7) {
            text += `- ${cells[0].textContent.trim()}: ${cells[1].textContent.trim()} مورد - هزینه: ${cells[3].textContent.trim()}\n`;
        }
    });
    
    const total = document.getElementById('totalCost');
    if (total) text += `\nهزینه کل: ${total.textContent.trim()}`;
    
    if (navigator.share) {
        try {
            await navigator.share({ title: 'گزارش برآورد خسارت', text: text });
            setStatus('گزارش به اشتراک گذاشته شد.', 'ok');
        } catch (e) {}
    } else {
        copyReportToClipboard();
    }
}

function resetApp() {
    currentImage = null;
    sessionStorage.removeItem("carEstimatorResult");
    const uploadButton = document.getElementById("uploadButton"); if (uploadButton) uploadButton.value = "";
    const analyzeButton = document.getElementById("analyzeButton"); if (analyzeButton) analyzeButton.disabled = true;
    const specializedButton = document.getElementById('specializedAnalyzeButton'); if (specializedButton) specializedButton.disabled = true;
    const resultCard = document.getElementById("resultCard"); if (resultCard) resultCard.classList.add("hidden");
    const resultBody = document.getElementById("resultBody"); if (resultBody) resultBody.innerHTML = "";
    if (overlay) { overlay.getContext("2d").clearRect(0, 0, overlay.width, overlay.height); overlay.style.display = "none"; }
    const preview = document.getElementById("preview"); if (preview) { preview.src = ""; preview.style.display = "none"; }
    const brandGroupSelect = document.getElementById("brandGroupSelect"); if (brandGroupSelect) brandGroupSelect.value = "";
    const vehicleModelSelect = document.getElementById("vehicleModelSelect"); if (vehicleModelSelect) { vehicleModelSelect.innerHTML = '<option value="">ابتدا دسته خودرو را انتخاب کنید</option>'; vehicleModelSelect.disabled = true; }
    const vehicleYearSelect = document.getElementById("vehicleYearSelect"); if (vehicleYearSelect) { vehicleYearSelect.innerHTML = '<option value="">ابتدا مدل خودرو را انتخاب کنید</option>'; vehicleYearSelect.disabled = true; }
    setStatus("آماده برای انتخاب تصویر جدید.", "info");
}
window.resetApp = resetApp;

window.addEventListener("DOMContentLoaded", function () {
    const savedResult = sessionStorage.getItem("carEstimatorResult");
    const resultCard = document.getElementById("resultCard");
    if (savedResult && resultCard) {
        resultCard.innerHTML = savedResult;
        resultCard.classList.remove("hidden");
    }
});
</script>
<script>
  // مدل فقط پس از تعریف تمام توابع و رویدادهای رابط اجرا شود

</script>


<script id="vehicle-dropdown-fix">
(function () {
  const data = {
    iran_khodro: [
      ["peykan","پیکان"],["samand","سمند"],["samand_soren","سمند سورن"],
      ["dena","دنا"],["dena_plus","دنا پلاس"],["dena_plus_turbo","دنا پلاس توربو"],
      ["peugeot_405","پژو ۴۰۵"],["peugeot_pars","پژو پارس"],["peugeot_206","پژو ۲۰۶"],
      ["peugeot_207","پژو ۲۰۷"],["peugeot_207_panorama","پژو ۲۰۷ پانوراما"],
      ["runna","رانا"],["runna_plus","رانا پلاس"],["tara","تارا"],
      ["tara_v1","تارا دستی"],["tara_v4","تارا اتوماتیک"],["arisun","آریسان"],
      ["haima_s5","هایما S5"],["haima_s7","هایما S7"],["haima_8s","هایما 8S"]
    ],
    saipa: [
      ["pride","پراید"],["pride_131","پراید ۱۳۱"],["pride_132","پراید ۱۳۲"],
      ["pride_111","پراید ۱۱۱"],["tiba","تیبا"],["tiba2","تیبا ۲"],
      ["saipa_s","سایپا S"],["quick","کوییک"],["quick_r","کوییک R"],
      ["quick_at","کوییک اتوماتیک"],["shahin","شاهین"],["shahin_g","شاهین G"],
      ["shahin_at","شاهین اتوماتیک"],["changan_cs35","چانگان CS35"],
      ["zotye","زوتی آریو"]
    ],
    montage: [
      ["fidelity","فیدلیتی"],["fidelity_prime","فیدلیتی پرایم"],
      ["dignity","دیگنیتی"],["dignity_prime","دیگنیتی پرایم"],
      ["tiggo5","چری تیگو ۵"],["tiggo7","چری تیگو ۷"],["tiggo8","چری تیگو ۸"],
      ["arrizo5","آریزو ۵"],["arrizo6","آریزو ۶"],
      ["kerman_jac_s3","جک S3"],["kerman_jac_s5","جک S5"],
      ["lamari","لاماری ایما"],["kmc_j7","KMC J7"],["kmc_t8","KMC T8"],
      ["haima_7x","هایما 7X"]
    ],
    import: [
      ["corolla","تویوتا کرولا"],["camry","تویوتا کمری"],["rav4","تویوتا RAV4"],
      ["elantra","هیوندای النترا"],["sonata","هیوندای سوناتا"],
      ["tucson","هیوندای توسان"],["santa_fe","هیوندای سانتافه"],
      ["kia_cerato","کیا سراتو"],["kia_sportage","کیا اسپورتیج"],
      ["mazda3","مزدا ۳"],["nissan_xtrail","نیسان ایکس‌تریل"]
    ]
  };

  const years = [];
  for (let y = 1405; y >= 1380; y--) years.push(y);

  window.fixVehicleModels = function () {
    const g = document.getElementById("brandGroupSelect");
    const m = document.getElementById("vehicleModelSelect");
    const y = document.getElementById("vehicleYearSelect");
    if (!g || !m || !y) return;

    m.innerHTML = '<option value="">مدل خودرو را انتخاب کنید</option>';
    y.innerHTML = '<option value="">ابتدا مدل خودرو را انتخاب کنید</option>';
    y.disabled = true;

    const list = data[g.value];
    if (!list) {
      m.disabled = true;
      return;
    }

    for (const item of list) {
      const o = document.createElement("option");
      o.value = item[0];
      o.textContent = item[1];
      m.appendChild(o);
    }

    m.disabled = false;
  };

  window.fixVehicleYears = function () {
    const m = document.getElementById("vehicleModelSelect");
    const y = document.getElementById("vehicleYearSelect");
    if (!m || !y) return;

    y.innerHTML = '<option value="">سال ساخت را انتخاب کنید</option>';

    if (!m.value) {
      y.disabled = true;
      return;
    }

    for (const value of years) {
      const o = document.createElement("option");
      o.value = value;
      o.textContent = value;
      y.appendChild(o);
    }

    y.disabled = false;
  };

  const g = document.getElementById("brandGroupSelect");
  const m = document.getElementById("vehicleModelSelect");

  if (g) {
    g.onchange = window.fixVehicleModels;
    g.disabled = false;
  }

  if (m) {
    m.onchange = window.fixVehicleYears;
  }

  window.fixVehicleModels();

  console.log("Vehicle dropdown FIX loaded");
})();
</script>

</body>
</html>

