<script id="supabase-chat-script">
(function () {
  const SUPABASE_URL = 'https://zpobmwhvhqjcqmaoqtxq.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_ruoLdqEOaFEuQjPt5e0Huw_KwKAOp4T';
  const API_URL = SUPABASE_URL + '/rest/v1/messages';

  const fab = document.getElementById('chat-fab');
  const chatWindow = document.getElementById('chat-window');
  const input = document.getElementById('chat-input');
  const sendButton = document.getElementById('chat-send');
  const messages = document.getElementById('chat-messages');

  if (!fab || !chatWindow || !input || !sendButton || !messages) return;

  function addMessage(text, type) {
    const message = document.createElement('div');
    message.className = 'msg ' + type;
    message.textContent = text;
    messages.appendChild(message);
    messages.scrollTop = messages.scrollHeight;
  }

  function renderMessages(data) {
    messages.innerHTML = '';
    if (!data || data.length === 0) {
      addMessage('سلام! چطور می‌توانم کمک کنم؟', 'expert');
      return;
    }
    data.forEach(function (item) {
      addMessage(item.text, item.sender === 'expert' ? 'expert' : 'user');
    });
  }

  async function loadMessages() {
    try {
      const response = await fetch(
        API_URL + '?select=id,text,sender,created_at&order=created_at.asc',
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY } }
      );
      if (!response.ok) throw new Error('خطا در دریافت پیام‌ها');
      renderMessages(await response.json());
    } catch (error) {
      console.error(error);
    }
  }

  async function sendMessage(event) {
    if (event) event.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    sendButton.disabled = true;
    input.value = '';

    try {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify({ text: text, sender: 'user' })
      });

      if (!response.ok) throw new Error('خطا در ارسال پیام');
      await loadMessages();
    } catch (error) {
      console.error(error);
      addMessage('ارسال پیام ناموفق بود. اتصال اینترنت را بررسی کنید.', 'expert');
      input.value = text;
    } finally {
      sendButton.disabled = false;
      input.focus();
    }
  }

  fab.onclick = function () {
    chatWindow.classList.toggle('active');
    if (chatWindow.classList.contains('active')) loadMessages();
  };

  sendButton.onclick = sendMessage;
  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter') sendMessage(event);
  });

  setInterval(function () {
    if (chatWindow.classList.contains('active')) loadMessages();
  }, 5000);
})();
