const brandGroupSelect = document.getElementById('brandGroupSelect');
const vehicleModelSelect = document.getElementById('vehicleModelSelect');
if (brandGroupSelect) brandGroupSelect.addEventListener('change', updateVehicleModels);
if (vehicleModelSelect) vehicleModelSelect.addEventListener('change', window.updateAnalyzeButton);
