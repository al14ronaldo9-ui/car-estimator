(() => {
  const button = document.getElementById('analyzeButton');
  if (!button || button.dataset.softAnimationReady) return;

  button.dataset.softAnimationReady = 'true';

  let watcher = null;

  const stopAnimation = () => {
    button.classList.remove('is-analyzing');
    if (watcher) {
      clearInterval(watcher);
      watcher = null;
    }
  };

  button.addEventListener('click', () => {
    requestAnimationFrame(() => {
      button.classList.add('is-analyzing');

      watcher = setInterval(() => {
        const resultCard = document.querySelector('#resultCard');

        if (
          !button.disabled ||
          (resultCard && !resultCard.classList.contains('hidden'))
        ) {
          stopAnimation();
        }
      }, 250);
    });
  });

  window.addEventListener('error', stopAnimation);
})();
</script>


