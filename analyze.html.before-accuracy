    window.updateAnalyzeButton();
    setStatus(session ? 'تصویر آماده است. روی «شروع آنالیز تصویر» بزنید.' : 'مدل هنوز بارگذاری نشده است...', session ? 'ok' : 'error');
  };
  img.onerror = function () {
    setStatus('خطا در خواندن تصویر.', 'error');
  };
  img.src = url;
});

analyzeButton.addEventListener('click', async function () {
    return; // هندلر قدیمی غیرفعال شد — مسیر فعال: showResultsWithOptions (رفع اجرای دوباره)
  if (!session || !currentImage) return;
  analyzeButton.disabled = true;
  clearDbg();
  setStatus('در حال تحلیل تصویر... (چند ثانیه صبر کنید)');

  try {
    const meta0 = letterbox(currentImage, INPUT_SIZE);
    const tensor = canvasToTensor(meta0.canvas);
    const feeds = { [session.inputNames[0]]: tensor };
    const outputs = await session.run(feeds);

    const names = Object.keys(outputs);
    dbg('خروجی‌های مدل: ' + names.map(n => n + ':[' + outputs[n].dims.join(',') + ']').join('  |  '));

    let out0 = null, out1 = null;
    for (const nm of names) {
      if (outputs[nm].dims.length === 3) out0 = outputs[nm];
      if (outputs[nm].dims.length === 4) out1 = outputs[nm];
    }

    if (!out0) {
      throw new Error('خروجی تشخیص (۳بعدی) پیدا نشد. shapes: ' + names.map(n => n + ':[' + outputs[n].dims.join(',') + ']').join(' '));
    }
    if (!out1) {
      throw new Error('خروجی پروتوتایپ ماسک (۴بعدی) پیدا نشد. shapes: ' + names.map(n => n + ':[' + outputs[n].dims.join(',') + ']').join(' '));
    }

    const meta = {
      scale: meta0.scale,
      dx: meta0.dx,
      dy: meta0.dy,
      w: meta0.w,
      h: meta0.h,
      origW: currentImage.naturalWidth,
      origH: currentImage.naturalHeight
    };

    const results = analyzeOutput(out0, out1, meta);

    drawResults(results, currentImage, meta);
    // رندر قدیمی غیرفعال شد؛ گزارش از مسیر showResultsWithOptions نمایش داده می‌شود

    if (results.length === 0) {
      setStatus('آسیبی با اطمینان کافی پیدا نشد (آستانه: ' + CONF_THRESHOLD + '). جزئیات فنی در باکس دیباگ.', 'error');
    } else {
      setStatus('تحلیل با موفقیت انجام شد — ' + results.length + ' آسیب شناسایی شد.', 'ok');
    }
  } catch (e) {
    console.error(e);
    setStatus('خطا در تحلیل: ' + e.message, 'error');
  } finally {
    window.updateAnalyzeButton();
  }
});

async function fetchModelWithProgress(url) {
  const cacheName = 'car-estimator-model-v1';
  let cachedResponse = null;
  if ('caches' in window) {
    try {
      const cache = await caches.open(cacheName);
      cachedResponse = await cache.match(url);
      if (cachedResponse) {
        setStatus('مدل از حافظه موقت (کش) لود شد. در حال مقداردهی...');
        return await cachedResponse.arrayBuffer();
      }
    } catch (err) {
      console.warn('Cache API error:', err);
    }
  }

  setStatus('در حال دانلود مدل هوش مصنوعی (۰٪)...');
  const response = await fetch(url);
  if (!response.ok) throw new Error('دانلود ناموفق بود: ' + response.statusText);

  const contentLength = response.headers.get('content-length');
  const total = contentLength ? parseInt(contentLength, 10) : 0;
  
  if (!total || !response.body) {
    const buf = await response.arrayBuffer();
    return buf;
  }

  const reader = response.body.getReader();
  let receivedLength = 0;
  const chunks = [];

  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    chunks.push(value);
    receivedLength += value.length;
    const percent = Math.round((receivedLength / total) * 100);
    setStatus(`در حال دانلود مدل هوش مصنوعی (${percent}٪)...`);
  }

  const allChunks = new Uint8Array(receivedLength);
  let position = 0;
  for (const chunk of chunks) {
    allChunks.set(chunk, position);
    position += chunk.length;
  }

  if ('caches' in window) {
    try {
      const cache = await caches.open(cacheName);
      const clonedResp = new Response(allChunks.slice().buffer, {
        headers: { 'Content-Type': 'application/octet-stream' }
      });
      await cache.put(url, clonedResp);
    } catch (err) {
      console.warn('Cache save error:', err);
    }
  }

  return allChunks.buffer;
}

async function loadModel() {
  try {
    ort.env.wasm.numThreads = 1;
    ort.env.wasm.simd = false;

    const modelUrl = new URL('static/best.onnx', window.location.href).href;
    const modelBuffer = await fetchModelWithProgress(modelUrl);

    setStatus('در حال مقداردهی موتور هوش مصنوعی...');
    session = await ort.InferenceSession.create(modelBuffer, {
      executionProviders: ['wasm']
    });
    dbg('مدل لود شد. ورودی: ' + session.inputNames.join(', '));
    window.updateAnalyzeButton();
    setStatus('مدل آماده به کار است.', 'ok');
    if (currentImage) window.updateAnalyzeButton();
  } catch (e) {
    console.error(e);
    setStatus('خطا در لود مدل: ' + e.message, 'error');
  }
}

