function showResultsWithOptions(results) {
    const vehicle = getVehicleSelection();
    const counts = {};
    const ranges = {};
    let totalMin = 0;
    let totalMax = 0;

    for (const r of results) {
        counts[r.classId] = (counts[r.classId] || 0) + 1;
        const range = calculateRange(r.classId, r.areaFraction, vehicle ? vehicle.multiplier : 1);
        if (!ranges[r.classId]) {
            ranges[r.classId] = { min: 0, max: 0, scoreSum: 0 };
        }
        ranges[r.classId].min += range.min;
        ranges[r.classId].max += range.max;
        ranges[r.classId].scoreSum += r.score;
        totalMin += range.min;
        totalMax += range.max;
    }

    const summary = Object.keys(counts)
        .map(k => CLASS_NAMES[k] + '=' + counts[k])
        .join(' | ');
    dbg('خودرو: ' + (vehicle ? vehicle.groupLabel + ' - ' + vehicle.modelLabel : 'نامشخص') + ' | توزیع: ' + (summary || 'هیچ'));

    resultBody.innerHTML = '';
    let hasAny = false;

    for (let c = 0; c < NUM_CLASSES; c++) {
        if (!counts[c]) continue;
        hasAny = true;
        const color = CLASS_COLORS[c];
        const avgScore = Math.round(ranges[c].scoreSum / counts[c] * 100);
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><span class="dot" style="background: rgb(${color[0]},${color[1]},${color[2]})"></span> ${CLASS_NAMES[c]}</td>
            <td style="text-align: center; font-weight: bold;">${counts[c]}</td>
            <td style="text-align: center; font-weight: bold; color: #a78bfa;">${avgScore}٪</td>
            <td style="text-align: left; font-weight: bold; color: #38bdf8;">${ranges[c].min.toLocaleString('fa-IR')} تا ${ranges[c].max.toLocaleString('fa-IR')}</td>
        `;
        resultBody.appendChild(tr);
    }

    if (!hasAny) {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td colspan="4" style="text-align: center; color: var(--text-muted);">آسیبی با اطمینان کافی تشخیص داده نشد.</td>';
        resultBody.appendChild(tr);
    }

    
    totalCostEl.textContent = totalMin.toLocaleString('fa-IR') + ' تا ' + totalMax.toLocaleString('fa-IR') + ' تومان';

    resultCard.classList.remove('hidden');
    resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
// ===== پچ کردن کلیک دکمه آنالیز =====
const originalClickHandler = analyzeButton.click;
analyzeButton.addEventListener('click', async function () {
    if (isAnalyzing || !session || !currentImage) return;

    isAnalyzing = true;
    window.updateAnalyzeButton();
    showLoading();
    clearDbg();

    try {
        setStatus('آماده‌سازی عکس...');
        await new Promise(resolve => requestAnimationFrame(resolve));

        const meta0 = letterbox(currentImage, INPUT_SIZE);
        const tensor = canvasToTensor(meta0.canvas);
        const feeds = { [session.inputNames[0]]: tensor };

        setStatus('تشخیص آسیب با هوش مصنوعی...');
        await new Promise(resolve => requestAnimationFrame(resolve));
        const outputs = await session.run(feeds);

        const names = Object.keys(outputs);
        dbg('خروجی‌های مدل: ' + names.map(n => n + ':[' + outputs[n].dims.join(',') + ']').join('  |  '));

        let out0 = null, out1 = null;
        for (const nm of names) {
            if (outputs[nm].dims.length === 3) out0 = outputs[nm];
            if (outputs[nm].dims.length === 4) out1 = outputs[nm];
        }

        if (!out0) {
            throw new Error('خروجی تشخیص (۳بعدی) پیدا نشد.');
        }
        if (!out1) {
            throw new Error('خروجی پروتوتایپ ماسک (۴بعدی) پیدا نشد.');
        }

        const meta = {
            scale: meta0.scale, dx: meta0.dx, dy: meta0.dy,
            w: meta0.w, h: meta0.h,
            origW: currentImage.naturalWidth,
            origH: currentImage.naturalHeight
        };

        const results = analyzeOutput(out0, out1, meta);

        setStatus('محاسبه هزینه و اعمال ضرایب خودرو...');
        await new Promise(resolve => requestAnimationFrame(resolve));
        drawResults(results, currentImage, meta);

        setStatus('نمایش نتایج...');
        await new Promise(resolve => requestAnimationFrame(resolve));
        showResultsWithOptions(results);

        if (results.length === 0) {
            setStatus('آسیبی با اطمینان کافی پیدا نشد (آستانه: ' + CONF_THRESHOLD + ').', 'error');
        } else {
            setStatus('تحلیل کامل شد — ' + results.length + ' آسیب شناسایی شد.', 'ok');
        }
    } catch (e) {
        console.error(e);
        setStatus('خطا در تحلیل: ' + e.message, 'error');
    } finally {
        isAnalyzing = false;
        hideLoading();
        window.updateAnalyzeButton();
    }
});

async function copyReportToClipboard() {
    const vehicle = getVehicleSelection();
    let text = 'برآورد هزینه خسارت خودرو:\n';
    if (vehicle) text += `خودرو: ${vehicle.groupLabel} - ${vehicle.modelLabel}\n\n`;
    
    document.querySelectorAll('#resultBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length === 4) {
            text += `- ${cells[0].textContent.trim()}: ${cells[1].textContent.trim()} مورد (اطمینان: ${cells[2].textContent.trim()}) - هزینه: ${cells[3].textContent.trim()}\n`;
        }
    });
    
    const total = document.getElementById('totalCost');
    if (total) text += `\nهزینه کل: ${total.textContent.trim()}\n`;
    
    try {
        await navigator.clipboard.writeText(text);
        setStatus('متن برآورد با موفقیت کپی شد!', 'ok');
    } catch (e) {
        setStatus('خطا در کپی: ' + e.message, 'error');
    }
}

async function shareReport() {
    const vehicle = getVehicleSelection();
    let text = 'برآورد هزینه خسارت خودرو:\n';
    if (vehicle) text += `خودرو: ${vehicle.groupLabel} - ${vehicle.modelLabel}\n\n`;
    
    document.querySelectorAll('#resultBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length === 4) {
            text += `- ${cells[0].textContent.trim()}: ${cells[1].textContent.trim()} مورد - هزینه: ${cells[3].textContent.trim()}\n`;
        }
    });
    
    const total = document.getElementById('totalCost');
    if (total) text += `\nهزینه کل: ${total.textContent.trim()}`;
    
    if (navigator.share) {
        try {
            await navigator.share({ title: 'گزارش برآورد خسارت', text: text });
            setStatus('گزارش به اشتراک گذاشته شد.', 'ok');
        } catch (e) {}
    } else {
        copyReportToClipboard();
    }
}

function resetApp() {
    currentImage = null;
    document.getElementById('uploadButton').value = '';
    document.getElementById('analyzeButton').disabled = true;
    document.getElementById('resultCard').classList.add('hidden');
    document.getElementById('resultBody').innerHTML = '';
    setStatus('آماده برای انتخاب تصویر جدید.', 'info');
}

