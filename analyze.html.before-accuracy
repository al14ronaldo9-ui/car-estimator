function getVehicleSelection() {
  const groupEl = document.getElementById('brandGroupSelect');
  const modelEl = document.getElementById('vehicleModelSelect');
  if (!groupEl || !modelEl) return null;
  const groupKey = groupEl.value;
  const modelKey = modelEl.value;
  if (!groupKey || !modelKey) return null;
  const group = VEHICLE_GROUPS[groupKey];
  const model = group && group.models[modelKey];
  if (!group || !model) return null;
  return {
    groupKey: groupKey,
    modelKey: modelKey,
    groupLabel: group.label,
    modelLabel: model.label,
    multiplier: group.multiplier * model.multiplier
  };
}

function updateVehicleModels() {
  const groupEl = document.getElementById('brandGroupSelect');
  const modelEl = document.getElementById('vehicleModelSelect');
  if (!groupEl || !modelEl) return;
  const groupKey = groupEl.value;
  modelEl.innerHTML = '';
  if (!groupKey) {
    const opt = document.createElement('option');
    opt.value = '';
    opt.textContent = 'ابتدا دسته خودرو را انتخاب کنید';
    modelEl.appendChild(opt);
    modelEl.disabled = true;
  } else {
    const group = VEHICLE_GROUPS[groupKey];
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'انتخاب کنید...';
    modelEl.appendChild(placeholder);
    for (const [key, model] of Object.entries(group.models)) {
      const opt = document.createElement('option');
      opt.value = key;
      opt.textContent = model.label;
      modelEl.appendChild(opt);
    }
    modelEl.disabled = false;
  }
  window.updateAnalyzeButton();
}

function calculateRange(classId, areaFraction, multiplier) {
  const rule = COST_RULES[classId];

  const area = Math.min(1, Math.max(0, areaFraction || 0));
  const severity = Math.min(1, Math.max(0.15, area * 4));

  const minCost = Math.round(
    (rule.min + (rule.max - rule.min) * severity * 0.35) *
    multiplier / 100000
  ) * 100000;

  const maxCost = Math.round(
    (rule.min + (rule.max - rule.min) * severity * 0.90) *
    multiplier / 100000
  ) * 100000;

  return {
    min: Math.max(100000, minCost),
    max: Math.max(minCost, maxCost)
  };
}

let isAnalyzing = false;

window.updateAnalyzeButton = function () {
  const modelReady = (typeof session !== 'undefined' && !!session);
  const imageReady = (typeof currentImage !== 'undefined' && !!currentImage);
  const vehicleReady =
    (typeof getVehicleSelection === 'function' && !!getVehicleSelection());

  if (typeof analyzeButton !== 'undefined' && analyzeButton) {
    analyzeButton.disabled = isAnalyzing || !(modelReady && imageReady && vehicleReady);
  }
};

